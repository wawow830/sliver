# sliver-agent: the per-user session agent (renders the bar, serves the public D-Bus API).
# docs/agent.md, docs/api.md §7. Enable per user: systemctl --user enable --now sliver-agent
# (the RPM enables it by default through a user preset).
#
# Type=dbus: the unit counts as started once the agent owns io.github.wawow830.Sliver, so D-Bus
# activation (packaging/dbus/io.github.wawow830.Sliver.service) and ordering against it are exact.

[Unit]
Description=Sliver Touch Bar session agent
Documentation=https://github.com/wawow830/sliver/blob/main/docs/agent.md
PartOf=graphical-session.target
After=graphical-session.target
# Without a Touch Bar there's no sliverd socket. The agent then waits and retries, which is cheap,
# but don't start it at all on machines that have never had sliverd.
ConditionPathExists=/usr/libexec/sliverd

[Service]
Type=dbus
BusName=io.github.wawow830.Sliver
ExecStart=/usr/bin/sliver-agent
# always, not on-failure: a stray SIGTERM (pkill, a script) counts as a clean exit, and with
# on-failure the bar then stays on sliverd's built-in layer for the rest of the session (seen on
# the Mac14,7, T122 follow-up). The agent never exits 0 on its own (losing sliverd reconnects), so
# this can't loop; 'systemctl --user stop' and the session ending still stop it for good.
Restart=always
RestartSec=1s
# The agent is user code. It needs the session bus and the compositor socket, nothing special.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
