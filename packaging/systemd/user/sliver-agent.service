# sliver-agent: the per-user session agent (renders the bar, serves the public D-Bus API).
# sliver-agent(1). Enable per user: systemctl --user enable --now sliver-agent
# (the RPM enables it by default through a user preset).
#
# Type=dbus: the unit counts as started once the agent owns io.github.wawow830.Sliver, so D-Bus
# activation (packaging/dbus/io.github.wawow830.Sliver.service) and ordering against it are exact.

[Unit]
Description=Sliver Touch Bar session agent
Documentation=man:sliver-agent(1)
PartOf=graphical-session.target
After=graphical-session.target
# Not started where sliverd isn't installed (without its socket the agent waits and retries).
ConditionPathExists=/usr/libexec/sliverd

[Service]
Type=dbus
BusName=io.github.wawow830.Sliver
ExecStart=/usr/bin/sliver-agent
# always, not on-failure: systemd counts SIGTERM as a clean exit, and Type=dbus stops the unit
# with result 'success' when BusName= loses its owner (e.g. another agent took the name and
# exited). With on-failure the bar would stay on sliverd's built-in layer for the session. The
# agent never exits 0 on its own (losing sliverd reconnects), so this can't loop.
Restart=always
RestartSec=1s
# The agent needs the session bus and the compositor socket.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
