# sliverd: owns the Touch Bar (display, touch, backlight, key output). See sliverd(8).
#
# Started by udev (99-z-sliverd.rules) when the bar's digitizer appears, like tiny-dfr.
# If sliverd keeps failing, systemd hands the bar back to tiny-dfr.

[Unit]
Description=Sliver Touch Bar daemon
Documentation=man:sliverd(8)
Requires=sliverd.socket
After=sliverd.socket systemd-user-sessions.service systemd-logind.service plymouth-quit.service dev-sliver_display.device
BindsTo=dev-sliver_display.device
# Not Conflicts=tiny-dfr: that stops tiny-dfr as soon as a start is queued, even one the start
# limit then refuses, and OnFailure= doesn't fire again for an already-failed unit, which would
# leave the bar with no daemon. ExecStartPre below stops tiny-dfr only when a start really runs,
# and tiny-dfr.service.d/50-sliver.conf stops sliverd when tiny-dfr starts.
# At the start limit, OnFailure= starts tiny-dfr. Clear it with `systemctl reset-failed sliverd`.
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tiny-dfr.service

[Service]
Type=exec
# sliver-hw refuses to open the bar outside the safe-swap harness unless this is set. Only this
# unit sets it, because of its OnFailure= fallback.
Environment=SLIVER_SYSTEM_UNIT=1
# Blocking, so tiny-dfr has released DRM master before sliverd opens the card. Runs on every
# (re)start that the start limit lets through, never on a refused one. If it fails, so does the
# start. The package requires tiny-dfr.
ExecStartPre=+/usr/bin/systemctl stop tiny-dfr.service
ExecStart=/usr/libexec/sliverd
Sockets=sliverd.socket
Restart=always
RestartSec=500ms
# Restart without passing through 'failed', so OnFailure= (tiny-dfr) fires only once the start
# limit is hit, not on every crash (systemd >= 254).
RestartMode=direct
# No root at all: card (video), input devices + /dev/uinput (input), and a backlight that udev
# made group-writable for video. Session ownership comes from /run/systemd/seats (world-readable).
DynamicUser=yes
SupplementaryGroups=video input
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
# Same hardening as tiny-dfr's unit (backlight writes are known to work under it).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivateNetwork=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=16
