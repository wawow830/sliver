# sliverd: owns the Touch Bar (display, touch, backlight, key output). See docs/sliverd.md and
# docs/decisions/0005-sliverd-system-integration.md.
#
# Started by udev (99-z-sliverd.rules) when the bar's digitizer appears, like tiny-dfr.
# Invariant 1: if sliverd keeps failing, systemd hands the bar back to tiny-dfr.

[Unit]
Description=Sliver Touch Bar daemon
Documentation=https://github.com/wawow830/sliver/blob/main/docs/sliverd.md
Requires=sliverd.socket
After=sliverd.socket systemd-user-sessions.service systemd-logind.service plymouth-quit.service dev-sliver_display.device
BindsTo=dev-sliver_display.device
# Exactly one daemon drives the bar, but NOT via Conflicts=tiny-dfr: that stops tiny-dfr as soon
# as a start is queued, even one the start limit then refuses, and OnFailure= doesn't fire again
# for an already-failed unit. That left the real bar dead once (a second `systemctl start sliverd`
# after the fallback). Instead ExecStartPre below stops tiny-dfr only when a start really runs,
# and tiny-dfr's drop-in (tiny-dfr.service.d/50-sliver.conf) stops us when it starts.
# Restart=always retries quickly. If that hits the start limit, fall back to tiny-dfr. Clear it
# with `systemctl reset-failed sliverd`.
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tiny-dfr.service

[Service]
Type=exec
# sliver-hw refuses to open the bar outside the safe-swap harness unless this is set. Only this
# unit sets it: OnFailure=tiny-dfr above is the safety net here.
Environment=SLIVER_SYSTEM_UNIT=1
# Blocking, so tiny-dfr has released DRM master before we open the card. Runs on every (re)start
# that the start limit lets through, never on a refused one.
ExecStartPre=+/usr/bin/systemctl stop tiny-dfr.service
ExecStart=/usr/libexec/sliverd
Sockets=sliverd.socket
Restart=always
RestartSec=500ms
# Restart without passing through 'failed', so OnFailure= (tiny-dfr) fires only once the start
# limit is hit, not on every crash (systemd >= 254).
RestartMode=direct
# No root at all: card (video), input devices + /dev/uinput (input), and a backlight that udev
# made group-writable for video. Session ownership comes from /run/systemd/seats (world-readable).
DynamicUser=yes
SupplementaryGroups=video input
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
# Same hardening as tiny-dfr's unit (backlight writes are known to work under it).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivateNetwork=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=16
