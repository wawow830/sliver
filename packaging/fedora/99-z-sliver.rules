# Sliver's adapter only needs the tested M2 Touch Bar devices. Keep these
# rules tied to udev identity and input class so event numbering and names may
# change. This file sorts after 99-touchbar-seat.rules, which supplies the
# isolated Touch Bar seat used below.
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", DRIVERS=="adp", GROUP="sliver-drm", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ENV{ID_SEAT}=="seat-touchbar", \
  ENV{ID_INPUT_TOUCHSCREEN}=="1", GROUP="sliver-input", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ENV{ID_PATH}=="platform-24eb30000.input", \
  ENV{ID_INPUT_KEYBOARD}=="1", GROUP="sliver-input", MODE="0640"
KERNEL=="uinput", GROUP="sliver-input", MODE="0660"
SUBSYSTEM=="backlight", KERNEL=="*dsi*", GROUP="sliver-backlight", MODE="0660", \
  RUN+="/usr/bin/chgrp sliver-backlight /sys/class/backlight/%k/brightness", \
  RUN+="/usr/bin/chmod 0660 /sys/class/backlight/%k/brightness"
