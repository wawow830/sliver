<?xml version="1.0" encoding="UTF-8"?>
<!-- Sliver preset bundles (.sliver): one readable TOML file holding a whole Touch Bar setup
     (docs/ux.md §9, sliver_config::preset). Opens in Sliver's settings for review. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-sliver-preset">
    <comment>Sliver Touch Bar preset</comment>
    <sub-class-of type="application/toml"/>
    <generic-icon name="text-x-generic"/>
    <glob pattern="*.sliver"/>
    <magic priority="50">
      <match type="string" offset="0" value="# A sliver preset"/>
    </magic>
  </mime-type>
</mime-info>
