# D-Bus activation for the public Touch Bar API (docs/api.md §7). A client calling
# io.github.wawow830.Sliver (an app publishing items, sliverctl) starts the session agent through
# systemd, so it runs in its proper unit, never as a bus-spawned child.
[D-BUS Service]
Name=io.github.wawow830.Sliver
Exec=/bin/false
SystemdService=sliver-agent.service
