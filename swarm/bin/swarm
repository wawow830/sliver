#!/usr/bin/env python3
"""swarm: shared world for sliver's decentralized agent mesh.

No root agent. Peers coordinate through shared state in <git-common-dir>/swarm/:
a task board, a broadcast channel, per-peer inboxes, a needs-human queue, and a
peer registry (who knows what). `swarm pulse` is a dumb clock, not a planner:
it only wakes idle peers that have something to do.

Peers may (and should) improve this tool. Keep the state format backward compatible.
"""
import argparse, fcntl, json, os, re, shutil, subprocess, sys, textwrap, time, urllib.error, urllib.request
from datetime import datetime
from contextlib import contextmanager
from pathlib import Path

NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
DEFAULT_MODEL = os.environ.get("SWARM_MODEL", "cliproxy/claude-opus-5-5")
DEFAULT_THINKING = os.environ.get("SWARM_THINKING", "high")
NUDGE_COOLDOWN = 120          # seconds between nudges to the same peer
EXPLORE_COOLDOWN = 1800       # seconds between "board is empty, go find gaps" nudges per peer
MIN_FREE_GB = 6
LOW_DISK_GB = 15     # below this, the pulse clears build output (target/) of peers that aren't working
CLEAN_TO_GB = 25     # ...until roughly this much is free again


def sh(*args, check=True, cwd=None, capture=True):
    r = subprocess.run(args, cwd=cwd, text=True, capture_output=capture)
    if check and r.returncode != 0:
        raise SystemExit(f"swarm: command failed: {' '.join(args)}\n{r.stderr or r.stdout}")
    return r


def git(*args, **kw):
    return sh("git", *args, **kw)


def common_dir() -> Path:
    return Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip())


def main_checkout() -> Path:
    return common_dir().parent


def home() -> Path:
    p = Path(os.environ.get("SWARM_HOME") or common_dir() / "swarm")
    (p / "inbox").mkdir(parents=True, exist_ok=True)
    return p


def peers_root() -> Path:
    m = main_checkout()
    return m.parent / f"{m.name}.peers"


def now():
    return int(time.time())


def ago(t):
    if not t:
        return "-"
    d = now() - t
    for unit, s in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= s:
            return f"{d // s}{unit}"
    return f"{d}s"


# ---------------------------------------------------------------- state

EMPTY = {"version": 1, "next_task": 1, "next_human": 1, "seq": 0, "paused": False,
         "tasks": {}, "humans": {}, "peers": {}, "swarm": {}}


@contextmanager
def state(write=True):
    h = home()
    with open(h / "state.lock", "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX if write else fcntl.LOCK_SH)
        f = h / "state.json"
        s = json.loads(f.read_text()) if f.exists() else json.loads(json.dumps(EMPTY))
        for k, v in EMPTY.items():
            s.setdefault(k, json.loads(json.dumps(v)))
        yield s
        if write:
            s["seq"] += 1
            tmp = f.with_suffix(".tmp")
            tmp.write_text(json.dumps(s, indent=1))
            tmp.replace(f)


def append(path: Path, rec: dict):
    with open(path, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(rec) + "\n")


def read_jsonl(path: Path):
    if not path.exists():
        return []
    return [json.loads(l) for l in path.read_text().splitlines() if l.strip()]


def channel(kind, text, by=None, **extra):
    append(home() / "channel.log", {"at": now(), "by": by or me(required=False) or "?", "kind": kind, "text": text, **extra})


def me(required=True):
    n = os.environ.get("SWARM_NAME")
    if not n:
        try:
            b = git("rev-parse", "--abbrev-ref", "HEAD", check=False).stdout.strip()
            if b.startswith("peer/"):
                n = b[5:]
        except Exception:
            pass
    if not n and required:
        raise SystemExit("swarm: can't tell who you are (set SWARM_NAME or work on a peer/<name> branch)")
    return n


# ---------------------------------------------------------------- herdr

def herdr(*args, check=False):
    r = sh("herdr", *args, check=False)
    if check and r.returncode != 0:
        raise SystemExit(f"swarm: herdr {' '.join(args)} failed: {r.stderr.strip()}")
    try:
        return json.loads(r.stdout) if r.stdout.strip().startswith("{") else None
    except json.JSONDecodeError:
        return None


def agent_status(name):
    """idle|working|blocked|done|unknown, or None if no live agent with that name."""
    j = herdr("agent", "get", name)
    if not j:
        return None
    a = j.get("result", {}).get("agent", j.get("result", {}))
    return a.get("agent_status") or a.get("status")


def prompt_peer(name, text):
    j = herdr("agent", "prompt", name, text)
    return j is not None


def notify(title, body):
    herdr("notification", "show", title, "--body", body[:300], "--sound", "request")
    if shutil.which("notify-send"):
        sh("notify-send", "-a", "sliver swarm", "-u", "critical", title, body[:300], check=False)


# ---------------------------------------------------------------- tasks

def fmt_task(t):
    deps = f" after {','.join(t['after'])}" if t.get("after") else ""
    owner = f" @{t['owner']}" if t.get("owner") else ""
    area = f" [{t['area']}]" if t.get("area") else ""
    return f"{t['id']:>4} {t['status']:<8}{owner}{area} {t['title']}{deps}"


def blocked_by(s, t):
    return [d for d in t.get("after", []) if s["tasks"].get(d, {}).get("status") not in ("done", "dropped")]


def claimable(s):
    return [t for t in s["tasks"].values() if t["status"] == "open" and not blocked_by(s, t)]


def cmd_task(a):
    by = me(required=False) or "human"
    if a.sub == "add":
        with state() as s:
            tid = f"T{s['next_task']}"; s["next_task"] += 1
            after = [x.strip() for x in (a.after or "").split(",") if x.strip()]
            t = {"id": tid, "title": a.title, "body": a.body or "", "area": a.area or "", "after": after,
                 "status": "open", "owner": None, "created_by": by, "created_at": now(), "notes": []}
            if a.claim and not (is_peer() and s["paused"]):
                t.update(status="claimed", owner=by, claimed_at=now())
            s["tasks"][tid] = t
        channel("task", f"added {tid}: {a.title}", by=by, task=tid)
        print(tid)
    elif a.sub == "list":
        with state(write=False) as s:
            ts = sorted(s["tasks"].values(), key=lambda t: int(t["id"][1:]))
            for t in ts:
                if a.mine and t.get("owner") != by:
                    continue
                if not a.all and t["status"] in ("done", "dropped"):
                    continue
                b = " (blocked)" if t["status"] == "open" and blocked_by(s, t) else ""
                print(fmt_task(t) + b)
    elif a.sub == "show":
        with state(write=False) as s:
            t = s["tasks"].get(a.id) or sys.exit(f"no task {a.id}")
            print(fmt_task(t)); print(f"created by {t['created_by']} {ago(t['created_at'])} ago")
            if t["body"]:
                print("\n" + t["body"])
            for n in t["notes"]:
                print(f"\n-- {n['by']} {ago(n['at'])} ago:\n{n['text']}")
    else:
        with state() as s:
            t = s["tasks"].get(a.id) or sys.exit(f"no task {a.id}")
            if a.sub == "claim":
                refuse_if_paused("claiming")
                if t["status"] != "open" and not a.force:
                    sys.exit(f"{a.id} is {t['status']} by {t.get('owner')}; ask them, or --force if they're gone")
                if blocked_by(s, t) and not a.force:
                    sys.exit(f"{a.id} waits on {','.join(blocked_by(s, t))}")
                t.update(status="claimed", owner=by, claimed_at=now())
                msg = f"claimed {a.id}: {t['title']}"
            elif a.sub == "note":
                t["notes"].append({"by": by, "at": now(), "text": a.text}); msg = None
            elif a.sub == "done":
                t.update(status="done", done_at=now())
                if a.text: t["notes"].append({"by": by, "at": now(), "text": a.text})
                msg = f"done {a.id}: {t['title']}" + (f" — {a.text}" if a.text else "")
            elif a.sub == "release":
                t.update(status="open", owner=None)
                if a.text: t["notes"].append({"by": by, "at": now(), "text": a.text})
                msg = f"released {a.id}" + (f" — {a.text}" if a.text else "")
            elif a.sub == "drop":
                t.update(status="dropped"); t["notes"].append({"by": by, "at": now(), "text": a.text})
                msg = f"dropped {a.id} — {a.text}"
            elif a.sub == "edit":
                if a.title: t["title"] = a.title
                if a.body is not None: t["body"] = a.body
                if a.area is not None: t["area"] = a.area
                if a.after is not None: t["after"] = [x.strip() for x in a.after.split(",") if x.strip()]
                msg = None
        if msg:
            channel("task", msg, by=by, task=a.id)
        print("ok")


# ---------------------------------------------------------------- messaging

def cmd_say(a):
    channel("say", a.text)
    print("ok")


PAUSE_NOTE = ("The swarm is paused by the human. Finish the step you're on (commit, and land it if it's green), "
              "then end your turn. Don't claim or start new work. Your claims stay yours, and you'll be woken on resume.")


QUOTA_PAUSE_NOTE = ("The swarm is paused to save Claude usage (it resumes by itself when usage resets). Finish the step "
                    "you're on (commit, and land it if it's green), then end your turn. Don't claim or start new work. "
                    "Your claims stay yours, and you'll be woken on resume.")


def pause_note():
    try:
        by = json.loads((home() / "state.json").read_text()).get("swarm", {}).get("paused_by")
    except (OSError, ValueError):
        by = None
    return QUOTA_PAUSE_NOTE if by == "quota" else PAUSE_NOTE


def is_paused():
    try:
        return json.loads((home() / "state.json").read_text()).get("paused", False)
    except (OSError, ValueError):
        return False


def is_peer():
    n = me(required=False)
    return bool(n) and n != "human"


def refuse_if_paused(what):
    if is_peer() and is_paused():
        sys.exit(f"swarm: not {what}. {pause_note()}")


def deliver(to, frm, text, kind="msg", now_=False):
    append(home() / "inbox" / f"{to}.jsonl", {"at": now(), "from": frm, "kind": kind, "text": text})
    if is_paused():
        return  # queued; the pulse delivers it on resume
    st = agent_status(to)
    if st in ("idle", "done") or (now_ and st == "working"):
        prompt_peer(to, f"[swarm] new message from {frm}. Run `swarm inbox`.")
        with state() as s:
            if to in s["peers"]:
                s["peers"][to]["last_nudge"] = now()


def cmd_send(a):
    with state(write=False) as s:
        if a.peer not in s["peers"]:
            sys.exit(f"unknown peer {a.peer}; see `swarm peers`")
    deliver(a.peer, me(required=False) or "human", a.text, now_=a.now)
    print("ok (queued: the swarm is paused, delivered on resume)" if is_paused() else "ok")


def cmd_inbox(a):
    n = me()
    msgs = read_jsonl(home() / "inbox" / f"{n}.jsonl")
    with state(write=not a.peek) as s:
        p = s["peers"].setdefault(n, {})
        start = 0 if a.all else p.get("inbox_read", 0)
        for m in msgs[start:]:
            print(f"[{ago(m['at'])} ago] {m['from']} ({m['kind']}): {m['text']}\n")
        if not msgs[start:]:
            print("(no new messages)")
        if not a.peek:
            p["inbox_read"] = len(msgs)


def unread(name, s):
    return len(read_jsonl(home() / "inbox" / f"{name}.jsonl")) - s["peers"].get(name, {}).get("inbox_read", 0)


def cmd_log(a):
    for r in read_jsonl(home() / "channel.log")[-a.n:]:
        print(f"[{ago(r['at']):>4}] {r['by']:<8} {r['kind']:<6} {r['text']}")


# ---------------------------------------------------------------- humans

MAX_QUESTION = 200  # the question itself; context goes in --detail


def color(code, s):
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return s
    return f"\033[{code}m{s}\033[0m"


def wrap(text, indent, first=None, style=None):
    width = min(shutil.get_terminal_size((100, 24)).columns, 100) - 1
    out, first = [], first if first is not None else indent
    for para in str(text).split("\n"):
        if not para.strip():
            out.append(""); continue
        for line in textwrap.wrap(para, width=width, initial_indent=first, subsequent_indent=indent):
            out.append(color(style, line) if style else line)
        first = indent
    return out


def letter(i):
    return chr(ord("a") + i)


def render_human(h, hint=True):
    meta = " · ".join(x for x in (h["kind"], h["by"], f"{ago(h['at'])} ago", h.get("task")) if x)
    out = [f"{color('1;33', h['id'])}  {color('2', meta)}"]
    out += wrap(h["text"], "  ", style="1")
    if h.get("detail"):
        out += [""] + wrap(h["detail"], "  ")
    opts, pick = h.get("options") or [], h.get("pick")
    if opts:
        out.append("")
        for i, o in enumerate(opts):
            lines = wrap(o, "       ", first=f"    {letter(i)}) ")
            if i == pick:
                lines[-1] += color("32", "  ← recommended")
            out += lines
    if h["status"] == "answered":
        out += [""] + wrap(h.get("answer", ""), "    ", first="  ✓ ", style="32")
        for r in h.get("revisions", []):
            out += wrap(r["answer"], "    ", first="  ✗ was: ", style="2")
        if hint:
            out += ["", color("2", f"  → swarm human edit {h['id']}")]
    elif hint:
        choices = "/".join(letter(i) for i in range(len(opts)))
        hint = f"swarm human answer {h['id']} " + (f"{choices}" + ("/ok" if pick is not None else "") + " or text" if opts else '"..."')
        out += ["", color("2", f"  → {hint}")]
    return "\n".join(out)


def brief_human(h):
    opts, pick = h.get("options") or [], h.get("pick")
    choice = " [" + "/".join(letter(i) + ("*" if i == pick else "") for i in range(len(opts))) + "]" if opts else ""
    q = h["text"].split("\n")[0]
    q = q if len(q) <= 70 else q[:67] + "..."
    if h["status"] == "answered":
        ans = h.get("answer", "")
        choice = color("32", "  ✓ " + (ans if len(ans) <= 40 else ans[:37] + "..."))
    return f"{h['id']:>4} {h['kind']:<9} {h['by']:<7} {q}{choice}"


def expand_answer(h, text):
    """'b' -> 'b) <option>', 'ok' -> the recommended option."""
    opts, pick, t = h.get("options") or [], h.get("pick"), text.strip()
    if opts and t.lower() in ("ok", "y", "yes", "pick") and pick is not None:
        return f"{letter(pick)}) {opts[pick]} (your recommendation)"
    if opts and len(t) == 1 and t.lower() in [letter(i) for i in range(len(opts))]:
        i = ord(t.lower()) - ord("a")
        return f"{letter(i)}) {opts[i]}"
    m = re.match(r"^([a-z])[)\s:,-]+(.+)$", t, re.I | re.S)
    if opts and m and m.group(1).lower() in [letter(i) for i in range(len(opts))]:
        i = ord(m.group(1).lower()) - ord("a")
        return f"{letter(i)}) {opts[i]}. Note: {m.group(2)}"
    return t


def answer_human(hid, text):
    """Answer, or revise an earlier answer (the asker is told it changed)."""
    hid = hid.upper()
    with state() as s:
        h = s["humans"].get(hid) or sys.exit(f"no {hid}")
        ans = expand_answer(h, text)
        old = h.get("answer") if h["status"] == "answered" else None
        if old == ans:
            return ans + "  (unchanged)"
        if old is not None:
            h.setdefault("revisions", []).append({"answer": old, "at": h.get("answered_at")})
        h.update(status="answered", answer=ans, answered_at=now())
        asker = h["by"]
        if s["peers"].get(asker, {}).get("status") == "waiting":
            s["peers"][asker]["status"] = "active"
    q = h["text"][:100]
    if old is None:
        channel("human", f"{hid} answered: {ans}", by="human")
        deliver(asker, "human", f"answer to {hid} ({q}): {ans}", kind="human-answer")
    else:
        channel("human", f"{hid} answer CHANGED: {old} → {ans}", by="human")
        deliver(asker, "human", f"REVISED answer to {hid} ({q}): now {ans!r} (previously {old!r}). "
                "Revisit anything you did based on the old answer, and tell peers who relied on it.",
                kind="human-answer", now_=True)
    return ans if old is None else f"{old}  →  {ans}"


def open_humans(s, all_=False):
    hs = [h for h in s["humans"].values() if all_ or h["status"] == "open"]
    return sorted(hs, key=lambda h: int(h["id"][1:]))


def cmd_human(a):
    sub = a.sub or ("go" if sys.stdin.isatty() and sys.stdout.isatty() else "list")
    if sub == "ask":
        by = me()
        if len(a.text) > MAX_QUESTION:
            sys.exit(f"question is {len(a.text)} chars; keep it to one short sentence (<= {MAX_QUESTION}). "
                     "Put context in --detail and choices in --option (repeatable) with --pick. One question per ask.")
        opts = a.option or []
        pick = None
        if a.pick:
            p = a.pick.strip().lower()
            low = [o.strip().lower() for o in opts]
            if p.isdigit():
                pick = int(p) - 1
            elif len(p) == 1:
                pick = ord(p) - ord("a")
            else:  # the option's own text is fine too
                pick = low.index(p) if p in low else -1
            if not 0 <= pick < len(opts):
                sys.exit("--pick must name one of the --option entries (a, b, ... or 1, 2, ...)")
        with state() as s:
            hid = f"H{s['next_human']}"; s["next_human"] += 1
            s["humans"][hid] = {"id": hid, "by": by, "kind": a.kind, "task": a.task, "text": a.text,
                                "detail": a.detail or "", "options": opts, "pick": pick,
                                "status": "open", "at": now()}
            if a.block:
                s["peers"].setdefault(by, {})["status"] = "waiting"
        channel("human", f"{hid} ({a.kind}) {a.text}", by=by)
        notify(f"sliver needs you: {hid} ({a.kind})", f"{by}: {a.text}")
        print(hid)
    elif sub == "list":
        with state(write=False) as s:
            hs = open_humans(s, a.all)
        if not hs:
            print("(nothing needs you)"); return
        if a.brief:
            print("\n".join(brief_human(h) for h in hs)); return
        rule = color("2", "─" * min(shutil.get_terminal_size((100, 24)).columns, 100))
        print(f"\n{rule}\n".join(render_human(h) for h in hs))
        if not a.all:
            print(color("2", f"\n{len(hs)} open. `swarm human` walks through them one at a time."))
    elif sub == "answer":
        print(answer_human(a.id, a.text))
    elif sub == "go":
        with state(write=False) as s:
            hs = open_humans(s)
        if not hs:
            print("(nothing needs you. `swarm human edit` changes an earlier answer)"); return
        print(color("2", "Enter = skip, q = quit. Reply with a letter, 'ok' for the recommendation, or any text.\n"))
        for n, h in enumerate(hs, 1):
            print(color("2", f"[{n}/{len(hs)}]"), render_human(h, hint=False))
            try:
                ans = input(color("1;36", "\n  answer› ")).strip()
            except (EOFError, KeyboardInterrupt):
                print(); return
            if ans.lower() in ("q", "quit"):
                return
            if ans:
                print(color("32", "  ✓ " + answer_human(h["id"], ans)))
            print()
    elif sub == "edit":
        if a.id and a.text:
            print(answer_human(a.id, a.text)); return
        with state(write=False) as s:
            done = [h for h in open_humans(s, True) if h["status"] == "answered"]
        if not done:
            print("(nothing answered yet)"); return
        hid = a.id
        try:
            if not hid:
                print("\n".join(brief_human(h) for h in done))
                hid = input(color("1;36", "\n  which one? ")).strip()
                if not hid:
                    return
            hid = hid.upper() if hid.upper().startswith("H") else f"H{hid}"
            h = next((h for h in done if h["id"] == hid), None) or sys.exit(f"{hid} isn't an answered question")
            print("\n" + render_human(h, hint=False))
            ans = input(color("1;36", "\n  new answer (Enter = keep)› ")).strip()
        except (EOFError, KeyboardInterrupt):
            print(); return
        if ans:
            print(color("32", "  ✓ " + answer_human(hid, ans)))


# ---------------------------------------------------------------- peers

def cmd_peers(a):
    with state(write=False) as s:
        if not s["peers"]:
            print("(no peers)")
        for n, p in sorted(s["peers"].items()):
            if p.get("status") == "gone" and not a.all:
                continue
            owned = [t["id"] for t in s["tasks"].values() if t.get("owner") == n and t["status"] == "claimed"]
            live = agent_status(n) or "absent"
            print(f"{n:<10} {p.get('status', 'active'):<8} agent={live:<8} model={p.get('model', '?')} "
                  f"tasks={','.join(owned) or '-'} unread={unread(n, s)}")
            if p.get("knows"):
                print(f"           knows: {p['knows']}")


def cmd_knows(a):
    n = me()
    with state() as s:
        s["peers"].setdefault(n, {})["knows"] = a.text
    channel("peer", f"now knows: {a.text}", by=n)
    print("ok")


def set_status(status, reason):
    n = me()
    with state() as s:
        p = s["peers"].setdefault(n, {})
        p["status"] = status
        p["status_seq"] = s["seq"]
        p["open_at_rest"] = sorted(t["id"] for t in claimable(s))
    channel("peer", f"{status}" + (f": {reason}" if reason else ""), by=n)
    print("ok")


def cmd_rest(a):
    set_status("resting", a.reason)


def cmd_wake(a):
    refuse_if_paused("waking")
    set_status("active", a.reason)


def swarm_tab():
    with state(write=False) as s:
        return s["swarm"].get("tab_id"), s["swarm"].get("workspace_id")


def pick_split_target(tab_id):
    j = herdr("pane", "list", "--workspace", tab_id.split(":")[0])
    panes = [p for p in (j or {}).get("result", {}).get("panes", []) if p.get("tab_id") == tab_id]
    best, area = None, -1
    for p in panes:
        lj = herdr("pane", "layout", "--pane", p["pane_id"])
        for r in (lj or {}).get("result", {}).get("layout", {}).get("panes", []):
            if r["pane_id"] == p["pane_id"]:
                w, h = r["rect"]["width"], r["rect"]["height"]
                if w * h > area:
                    best, area, direction = p["pane_id"], w * h, ("right" if w > 2.6 * h else "down")
    if not best:
        raise SystemExit("swarm: no panes in swarm tab; run `swarm up`")
    return best, direction


def cmd_spawn(a):
    refuse_if_paused("spawning")
    name = a.name
    if not NAME_RE.match(name):
        sys.exit("name must match [a-z][a-z0-9_-]{0,31}")
    with state(write=False) as s:
        if s["peers"].get(name, {}).get("status") not in (None, "gone"):
            sys.exit(f"{name} already exists")
    tab, _ = swarm_tab()
    if not tab:
        sys.exit("no swarm tab; run `swarm up` first")
    free_gb = shutil.disk_usage(str(main_checkout())).free / 1e9
    if free_gb < MIN_FREE_GB:
        sys.exit(f"only {free_gb:.1f} GB free; ask the human (`swarm human ask --kind system ...`) before spawning")
    wt = peers_root() / name
    git("fetch", "-q", "origin", check=False, cwd=main_checkout())
    if not wt.exists():
        wt.parent.mkdir(parents=True, exist_ok=True)
        base = "origin/main" if git("rev-parse", "-q", "--verify", "origin/main", check=False).returncode == 0 else "main"
        exists = git("rev-parse", "-q", "--verify", f"refs/heads/peer/{name}", check=False).returncode == 0
        if exists:
            git("worktree", "add", str(wt), f"peer/{name}", cwd=main_checkout())
        else:
            git("worktree", "add", "-b", f"peer/{name}", str(wt), base, cwd=main_checkout())
    target, direction = pick_split_target(tab)
    path_env = f"{wt}/swarm/bin:{os.environ.get('PATH', '')}"
    j = herdr("pane", "split", target, "--direction", direction, "--cwd", str(wt), "--no-focus",
              "--env", f"SWARM_NAME={name}", "--env", f"PATH={path_env}", check=True)
    pane = j["result"]["pane"]["pane_id"]
    herdr("pane", "rename", pane, name)
    time.sleep(1.5)
    model = a.model or DEFAULT_MODEL
    pi_args = ["--model", model, "--thinking", a.thinking or DEFAULT_THINKING, "--name", f"sliver:{name}", "-a"]
    if a.resume:
        pi_args.insert(0, "-c")
    r = sh("herdr", "agent", "start", name, "--kind", "pi", "--pane", pane, "--timeout", "60000", "--", *pi_args, check=False)
    if r.returncode != 0:
        print(r.stderr, file=sys.stderr)
    with state() as s:
        p = s["peers"].setdefault(name, {})
        p.update(status="active", pane=pane, model=model, worktree=str(wt), joined=p.get("joined") or now(),
                 spawned_by=me(required=False) or "human")
        if a.knows:
            p["knows"] = a.knows
    channel("peer", f"spawned {name} ({model}) in {pane}" + (f" — {a.why}" if a.why else ""))
    onboarding = (f"You are `{name}`, a peer in sliver's decentralized agent swarm. There is no boss. "
                  "Read GOAL.md, SWARM.md and AGENTS.md now, then follow the loop in SWARM.md. "
                  "Start with `swarm peers`, `swarm log -n 40`, `swarm inbox`, `swarm task list`.")
    if a.resume:
        onboarding = "[swarm] you were revived after your agent exited. Re-read SWARM.md, then `swarm inbox` and `swarm task list --mine`, and continue."
    if a.brief:
        onboarding += f"\n\nBrief from whoever spawned you: {a.brief}"
    for _ in range(30):
        if agent_status(name) in ("idle", "done"):
            break
        time.sleep(2)
    prompt_peer(name, onboarding)
    print(f"{name} -> {pane} ({wt})")


def cmd_retire(a):
    name = a.name or me()
    with state() as s:
        p = s["peers"].get(name) or sys.exit(f"no peer {name}")
        p["status"] = "gone"
        for t in s["tasks"].values():
            if t.get("owner") == name and t["status"] == "claimed":
                t.update(status="open", owner=None)
                t["notes"].append({"by": name, "at": now(), "text": "released on retire"})
    channel("peer", f"{name} retired" + (f": {a.reason}" if a.reason else ""))
    print("ok (pane left open; close it with `herdr pane close` if you want)")


# ---------------------------------------------------------------- landing

def cmd_land(a):
    n = me()
    if git("status", "--porcelain").stdout.strip():
        sys.exit("working tree not clean: commit (or stash) first")
    with open(home() / "land.lock", "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for attempt in range(4):
            git("fetch", "-q", "origin")
            r = git("rebase", "origin/main", check=False)
            if r.returncode != 0:
                git("rebase", "--abort", check=False)
                sys.exit("rebase onto origin/main conflicts. Resolve it yourself: `git rebase origin/main`, fix, continue, then `swarm land` again. "
                         "If it touches a peer's area, `swarm send` them.")
            if git("rev-list", "--count", "origin/main..HEAD").stdout.strip() == "0":
                print("nothing to land"); return
            if not a.no_check:
                c = subprocess.run([str(Path(git('rev-parse', '--show-toplevel').stdout.strip()) / "scripts" / "check")])
                if c.returncode != 0:
                    sys.exit("scripts/check failed; not landing")
            p = git("push", "origin", "HEAD:main", check=False)
            if p.returncode == 0:
                head = git("log", "-1", "--format=%h %s").stdout.strip()
                count = git("rev-list", "--count", "ORIG_HEAD..HEAD", check=False).stdout.strip()
                channel("land", f"landed on main: {head}", by=n)
                m = main_checkout()
                if git("-C", str(m), "status", "--porcelain", check=False).stdout.strip() == "" and \
                        git("-C", str(m), "rev-parse", "--abbrev-ref", "HEAD", check=False).stdout.strip() == "main":
                    git("-C", str(m), "merge", "-q", "--ff-only", "origin/main", check=False)
                print(f"landed: {head}")
                return
            print(f"push rejected (attempt {attempt + 1}); retrying", file=sys.stderr)
        sys.exit("could not land after retries")


# ---------------------------------------------------------------- pulse

def nudge_for(name, p, s):
    st = p.get("status", "active")
    n_unread = unread(name, s)
    if n_unread:
        return f"[swarm] {n_unread} new message(s). Run `swarm inbox`."
    if st == "waiting":
        return None
    open_ids = sorted(t["id"] for t in claimable(s))
    if st == "resting":
        new = set(open_ids) - set(p.get("open_at_rest", []))
        if not new:
            return None
        return f"[swarm] new claimable task(s): {', '.join(sorted(new))}. `swarm wake` if you'll take one, else `swarm rest` again."
    mine = [t["id"] for t in s["tasks"].values() if t.get("owner") == name and t["status"] == "claimed"]
    if mine:
        return f"[swarm] continue your claimed task(s) {', '.join(mine)} (land via `swarm land`), or release/finish them. Then follow the SWARM.md loop."
    if open_ids:
        return f"[swarm] you have no claimed task. Claimable: {', '.join(open_ids[:12])}. Pick what fits your context best (`swarm task list`), or help a peer."
    if now() - p.get("last_explore", 0) > EXPLORE_COOLDOWN:
        p["last_explore"] = now()
        return ("[swarm] the board is empty. Compare GOAL.md against the actual repo and find the most valuable missing piece. "
                "Add tasks for it (`swarm task add`), tell peers on the channel, and take one. If you truly see nothing, `swarm rest`.")
    return None


GAP_REVIEW_EVERY = 1800  # seconds between stall-breaking gap reviews


def stall_breaker(s, lives):
    """Everyone resting with nothing new on the board is a stall, not "done": GOAL.md decides done.
    Resting peers only wake for new tasks or messages, so somebody has to go find the next work.
    Wake one resting peer (whoever explored longest ago) for a gap review."""
    peers = {n: p for n, p in s["peers"].items() if p.get("status") != "gone" and n in lives}
    if not peers or any(lives[n] not in ("idle", "done") for n in peers):
        return None
    if any(p.get("status", "active") == "active" for p in peers.values()):
        return None  # an active idle peer gets the normal explore nudge instead
    resting = [n for n, p in peers.items() if p.get("status") == "resting"]
    if not resting or now() - s["swarm"].get("last_gap_review", 0) < GAP_REVIEW_EVERY:
        return None
    name = min(resting, key=lambda n: (peers[n].get("last_explore", 0), n))
    p = peers[name]
    p.update(status="active", last_explore=now(), last_nudge=now())
    s["swarm"]["last_gap_review"] = now()
    left = sorted(t["id"] for t in claimable(s))
    msg = ("[swarm] Every peer is resting, but sliver isn't finished: GOAL.md's 'What complete means' and the Status "
           "column in docs/features.md still have partial and not-started rows. You're picked for a gap review. "
           "Find the most valuable missing pieces, add them as tasks small enough to land (`swarm task add`), "
           "`swarm say` a one-line summary so the peers who know those areas pick them up, and claim one yourself."
           + (f" Also decide whether open {', '.join(left)} should be taken or dropped." if left else "")
           + " If you truly find nothing worth doing, `swarm rest \"why\"`.")
    return ("gap", name, msg)


def free_gb():
    return shutil.disk_usage(str(main_checkout())).free / 1e9


def reclaim_disk():
    """Delete target/ of peers that aren't working, biggest first. Build output only: it's rebuilt on demand."""
    start = free_gb()
    if start >= LOW_DISK_GB:
        return []
    with state(write=False) as s:
        wts = {n: Path(p["worktree"]) / "target" for n, p in s["peers"].items() if p.get("worktree")}
    sized = []
    for n, t in wts.items():
        if t.is_dir():
            r = sh("du", "-sb", str(t), check=False)
            sized.append((int(r.stdout.split()[0]) if r.stdout.strip() else 0, n, t))
    freed, total = [], 0.0
    for size, n, t in sorted(sized, reverse=True):
        if start + total >= CLEAN_TO_GB:  # btrfs frees lazily, so count instead of re-measuring
            break
        if agent_status(n) == "working":
            continue
        shutil.rmtree(t, ignore_errors=True)
        freed.append((n, size / 1e9)); total += size / 1e9
    return freed


# ---------------------------------------------------------------- claude usage: auto-pause / auto-resume
#
# Reads each Claude login's usage from Anthropic's usage endpoint (what Claude Code's /usage shows), using the
# OAuth logins CLIProxyAPI already holds. Read-only: it never refreshes tokens, since that would break
# CLIProxyAPI's own refresh chain. Accounts are pooled with equal weight, because CLIProxyAPI round-robins them.

QUOTA_DEFAULTS = {"enabled": True, "pause_below": 40, "resume_at": 45, "windows": ["five_hour"], "every": 300}
WINDOW_NAMES = {"five_hour": "5-hour", "seven_day": "weekly"}
AUTH_DIR = Path(os.environ.get("SWARM_QUOTA_AUTH_DIR", "~/.cli-proxy-api")).expanduser()
USAGE_URL = os.environ.get("SWARM_QUOTA_URL", "https://api.anthropic.com/api/oauth/usage")


def quota_cfg(s):
    return {**QUOTA_DEFAULTS, **s.get("quota_cfg", {})}


def epoch(iso):
    try:
        return int(datetime.fromisoformat(iso).timestamp()) if iso else None
    except ValueError:
        return None


def when(t):
    """Local, human-friendly time: '18:00' today, else 'Tue 06:00'."""
    lt = time.localtime(t)
    return time.strftime("%H:%M" if lt[:3] == time.localtime()[:3] else "%a %H:%M", lt)


def fetch_accounts(prev):
    out, errors, missing = {}, [], []
    for f in sorted(AUTH_DIR.glob("claude-*.json")):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError) as e:
            errors.append(f"{f.name}: {e}"); continue
        if d.get("disabled"):
            continue
        email = d.get("email") or f.stem
        exp = epoch(d.get("expired"))
        if exp and exp < now():
            errors.append(f"{email}: token expired (CLIProxyAPI refreshes it on next use)")
        else:
            req = urllib.request.Request(USAGE_URL, headers={
                "Authorization": f"Bearer {d.get('access_token', '')}", "anthropic-beta": "oauth-2025-04-20",
                "Accept": "application/json", "User-Agent": "claude-cli/2.0 (external, cli)"})
            try:
                with urllib.request.urlopen(req, timeout=15) as r:
                    u = json.load(r)
                out[email] = {"at": now()}
                for w in WINDOW_NAMES:
                    x = u.get(w) or {}
                    out[email][w] = {"left": round(100 - float(x.get("utilization") or 0), 1), "resets": epoch(x.get("resets_at"))}
                continue
            except urllib.error.HTTPError as e:
                errors.append(f"{email}: couldn't refresh just now (HTTP {e.code}{', rate-limited' if e.code == 429 else ''})")
            except Exception as e:
                errors.append(f"{email}: {e}")
        if email in prev and now() - prev[email].get("at", 0) < 6 * 3600:  # fall back to the last reading
            out[email] = prev[email]
            errors[-1] += f", using the reading from {ago(prev[email]['at'])} ago"
        else:
            missing.append(email)
            errors[-1] += ", and there's no earlier reading, so auto-pause/resume waits for it"
    return out, errors, missing


def acct_left(a, w):
    x = a.get(w) or {}
    if x.get("resets") and x["resets"] <= now():
        return 100.0  # that window has reset since we last looked
    return float(x.get("left", 100.0))


def pooled(accounts, w):
    return sum(acct_left(a, w) for a in accounts.values()) / len(accounts)


def recovery_eta(accounts, windows, target):
    """When every watched window is back to `target`% left, if nothing else gets used. None if unknown."""
    eta = now()
    for w in windows:
        lefts = {e: acct_left(a, w) for e, a in accounts.items()}
        if sum(lefts.values()) / len(lefts) >= target:
            continue
        resets = sorted((a[w]["resets"], e) for e, a in accounts.items() if (a.get(w) or {}).get("resets"))
        for t, e in resets:
            lefts[e] = 100.0
            if sum(lefts.values()) / len(lefts) >= target:
                eta = max(eta, t); break
        else:
            return None
    return eta


def quota_summary(s):
    """(lowest % left, its window, {window: % left}) from the cached reading, or None."""
    cfg, accounts = quota_cfg(s), s.get("quota", {}).get("accounts", {})
    windows = [w for w in cfg["windows"] if w in WINDOW_NAMES]
    if not accounts or not windows:
        return None
    per = {w: pooled(accounts, w) for w in windows}
    w = min(per, key=per.get)
    return per[w], w, per


def quota_tick(max_age=None):
    """Refresh the usage reading when it's older than max_age (default: the check interval), then
    auto-pause or auto-resume. Returns a word for the pulse line."""
    with state(write=False) as s:
        cfg, q = quota_cfg(s), s.get("quota", {})
    if not cfg["enabled"]:
        return "off"
    if now() - q.get("at", 0) >= (cfg["every"] if max_age is None else max_age):
        accounts, errors, missing = fetch_accounts(q.get("accounts", {}))
        with state() as s:
            s["quota"] = {"at": now(), "accounts": accounts, "errors": errors, "missing": missing}
    action = None
    with state() as s:
        summ = quota_summary(s)
        if not summ:
            return "unknown"
        left, w, _ = summ
        sw = s["swarm"]
        if s["quota"].get("missing"):
            return f"partial({left:.0f}%)"  # a login couldn't be read: don't act on half the picture
        if sw.get("quota_override") and left >= cfg["resume_at"]:
            sw.pop("quota_override")  # recovered, so the human's override has done its job
        if not s["paused"] and not sw.get("quota_override") and left <= cfg["pause_below"]:
            s["paused"] = True
            sw.update(paused_at=now(), paused_by="quota")
            action = "pause"
        elif s["paused"] and sw.get("paused_by") == "quota" and left >= cfg["resume_at"]:
            s["paused"] = False
            sw.pop("paused_at", None); sw.pop("paused_by", None)
            action = "resume"
        eta = recovery_eta(s["quota"]["accounts"], [x for x in cfg["windows"] if x in WINDOW_NAMES], cfg["resume_at"])
        if s["paused"] and sw.get("paused_by") == "quota":
            sw["resume_eta"] = eta  # for the visualizer
        else:
            sw.pop("resume_eta", None)
    if action == "pause":
        back = f", expected around {when(eta)}" if eta else ""
        channel("system", f"auto-paused to save Claude usage: {left:.0f}% of the {WINDOW_NAMES[w]} limit is left "
                f"(the line is {cfg['pause_below']}%). It resumes by itself at {cfg['resume_at']}%{back}. {QUOTA_PAUSE_NOTE}", by="pulse")
        notify("sliver swarm paused", f"Claude usage: {left:.0f}% of the {WINDOW_NAMES[w]} limit left. "
               f"Resumes by itself{back}. `swarm resume` overrides.")
    elif action == "resume":
        channel("system", f"auto-resumed: Claude usage is back to {left:.0f}% left. Carry on where you left off.", by="pulse")
        notify("sliver swarm resumed", f"Claude usage is back to {left:.0f}% left.")
    return f"{left:.0f}%{'(' + action + ')' if action else ''}"


def cmd_quota(a):
    with state() as s:
        cfg = s.setdefault("quota_cfg", {})
        if a.on or a.off:
            cfg["enabled"] = bool(a.on)
        if a.pause_below is not None:
            cfg["pause_below"] = a.pause_below
        if a.resume_at is not None:
            cfg["resume_at"] = a.resume_at
        if a.windows:
            ws = [w.strip() for w in a.windows.split(",") if w.strip()]
            bad = [w for w in ws if w not in WINDOW_NAMES]
            if bad:
                sys.exit(f"unknown window(s) {', '.join(bad)}; use {', '.join(WINDOW_NAMES)}")
            cfg["windows"] = ws
        cfg = quota_cfg(s)
        if cfg["resume_at"] <= cfg["pause_below"]:
            sys.exit("--resume-at must be above --pause-below, or it would flap")
    quota_tick(max_age=60)  # the usage endpoint rate-limits hard, so reuse a fresh reading
    with state(write=False) as s:
        q, sw, paused = s.get("quota", {}), s["swarm"], s["paused"]
        summ = quota_summary(s)
    accounts = q.get("accounts", {})
    print(f"Claude usage left (CLIProxyAPI's logins, checked {ago(q.get('at'))} ago)\n")
    print(f"  {'':<26}" + "".join(f"{n:<26}" for n in WINDOW_NAMES.values()))
    for e, acc in accounts.items():
        cells = []
        for w in WINDOW_NAMES:
            r = (acc.get(w) or {}).get("resets")
            cells.append(f"{acct_left(acc, w):>3.0f}%" + (f" (resets {when(r)})" if r and r > now() else ""))
        print(f"  {e.split('@')[0]:<26}" + "".join(f"{c:<26}" for c in cells))
    if accounts:
        print(f"  {'together':<26}" + "".join(f"{pooled(accounts, w):>3.0f}%{'':<22}" for w in WINDOW_NAMES))
    for err in q.get("errors", []):
        print(color("33", f"  ! {err}"))
    watched = " and ".join(WINDOW_NAMES[w] for w in cfg["windows"])
    print(f"\nAuto-pause is {'on' if cfg['enabled'] else 'off'}: pauses at {cfg['pause_below']}% left, "
          f"resumes at {cfg['resume_at']}%, watching the {watched} limit.")
    if paused and sw.get("paused_by") == "quota":
        eta = recovery_eta(accounts, cfg["windows"], cfg["resume_at"])
        print(f"Paused to save usage since {when(sw.get('paused_at', now()))}" + (f", expected back around {when(eta)}." if eta else "."))
    elif paused:
        print("Paused by you, so it won't resume by itself.")
    elif sw.get("quota_override"):
        print("You resumed it while usage was low, so auto-pause is held off until usage recovers.")
    elif summ:
        print("Running.")


def cmd_pulse(a):
    print(f"swarm pulse every {a.interval}s. Ctrl+C to stop. (`swarm pause` / `swarm resume`)")
    warned_blocked, warned_disk = set(), 0
    revive_at = {}
    while True:
        try:
            try:
                usage = quota_tick()
            except Exception as e:  # a usage hiccup must never stop the pulse
                usage = f"error({e.__class__.__name__})"
            with state() as s:
                if s["paused"]:
                    print(time.strftime("%H:%M:%S"), "paused"); peers = {}
                else:
                    peers = s["peers"]
                actions, lives = [], {}
                for name, p in peers.items():
                    if p.get("status") == "gone":
                        continue
                    live = lives[name] = agent_status(name)
                    if live is None:
                        if now() - revive_at.get(name, 0) > 600:
                            revive_at[name] = now(); actions.append(("revive", name, None))
                        continue
                    if live == "blocked":
                        if name not in warned_blocked:
                            warned_blocked.add(name); actions.append(("blocked", name, None))
                        continue
                    warned_blocked.discard(name)
                    if live not in ("idle", "done"):
                        continue
                    if now() - p.get("last_nudge", 0) < NUDGE_COOLDOWN:
                        continue
                    msg = nudge_for(name, p, s)
                    if msg:
                        p["last_nudge"] = now(); actions.append(("nudge", name, msg))
                if not actions:
                    stall = stall_breaker(s, lives)
                    if stall:
                        actions.append(stall)
                open_h = [h["id"] for h in s["humans"].values() if h["status"] == "open"]
            for kind, name, msg in actions:
                if kind == "nudge":
                    prompt_peer(name, msg)
                elif kind == "gap":
                    channel("system", f"everyone is resting; woke {name} for a gap review against GOAL.md", by="pulse")
                    prompt_peer(name, msg)
                elif kind == "blocked":
                    notify(f"sliver: {name} is blocked", f"{name} is waiting at an approval/question UI. Look at its pane.")
                elif kind == "revive":
                    channel("peer", f"{name}'s agent is gone; reviving", by="pulse")
                    with state() as s:
                        pane = s["peers"][name].get("pane")
                    if pane and herdr("pane", "get", pane):
                        sh("herdr", "agent", "start", name, "--kind", "pi", "--pane", pane, "--timeout", "60000", "--",
                           "-c", "--model", s["peers"][name].get("model", DEFAULT_MODEL), "--thinking", DEFAULT_THINKING, "-a", check=False)
                        time.sleep(5)
                        prompt_peer(name, "[swarm] you were revived after your agent exited. Re-read SWARM.md, then `swarm inbox` and `swarm task list --mine`, and continue.")
                    else:
                        notify("sliver: peer lost", f"{name}'s pane is gone. `swarm spawn {name} --resume` to bring it back.")
            freed = reclaim_disk()
            if freed:
                what = ", ".join(f"{n} {g:.1f} GB" for n, g in freed)
                channel("system", f"disk was low, so I cleared target/ of idle peers ({what}). Your next build starts from scratch.", by="pulse")
                print(time.strftime("%H:%M:%S"), "reclaimed disk:", what, flush=True)
            free = free_gb()
            if free < MIN_FREE_GB and now() - warned_disk > 3600:
                warned_disk = now(); notify("sliver: disk low", f"{free:.1f} GB free, even after clearing idle peers' builds")
                channel("system", f"disk low: {free:.1f} GB free. If you're building, `cargo clean` when you're done.", by="pulse")
            line = " ".join(f"{k}:{v}" for k, v in (("nudged", ",".join(n for k_, n, _ in actions if k_ == "nudge") or "-"),
                                                    ("needs-human", ",".join(open_h) or "-"), ("usage-left", usage)))
            print(time.strftime("%H:%M:%S"), line, flush=True)
        except SystemExit as e:
            print("pulse error:", e, file=sys.stderr)
        except Exception as e:  # never die
            print("pulse error:", repr(e), file=sys.stderr)
        time.sleep(a.interval)


def live_peers(s):
    return [n for n, p in sorted(s["peers"].items()) if p.get("status") != "gone"]


def still_working(names):
    return [n for n in names if agent_status(n) == "working"]


def pulse_running():
    r = sh("pgrep", "-f", "swarm/bin/swarm pulse", check=False)
    return r.returncode == 0


def cmd_pause(a):
    """A natural stop: nobody gets woken, and working peers finish their turn on their own."""
    with state() as s:
        already = s["paused"]
        s["paused"] = True
        sw = s.setdefault("swarm", {})
        sw["paused_at"] = sw.get("paused_at") if already else now()
        took_over = sw.get("paused_by") == "quota"
        sw["paused_by"] = "human"  # a human pause is never auto-resumed
        names = live_peers(s)
    if not already:
        channel("system", f"swarm paused by the human. {PAUSE_NOTE}", by="human")
    elif took_over:
        print("it was paused to save usage; now it's your pause, so it won't resume by itself.")
    working = still_working(names)
    print("paused. Nobody gets woken: not by the pulse, and not by messages (they queue until resume).")
    print(f"still finishing their current turn: {', '.join(working)}" if working else "everyone has settled.")
    print("`swarm status` shows when they've settled. `swarm resume` picks up where they left off.")


def cmd_resume(a):
    with state() as s:
        was = s["paused"]
        s["paused"] = False
        sw = s.setdefault("swarm", {})
        sw.pop("paused_at", None); sw.pop("paused_by", None)
        queued = {n: unread(n, s) for n in live_peers(s)}
        summ, cfg = quota_summary(s), quota_cfg(s)
        low = cfg["enabled"] and summ and summ[0] < cfg["resume_at"]
        if low:
            sw["quota_override"] = True  # don't immediately re-pause what the human just resumed
    if was:
        channel("system", "swarm resumed by the human. Carry on where you left off.", by="human")
    q = ", ".join(f"{n} ({c})" for n, c in queued.items() if c > 0)
    print("resumed." if was else "wasn't paused.")
    if low:
        print(f"Claude usage is low ({summ[0]:.0f}% of the {WINDOW_NAMES[summ[1]]} limit left), so auto-pause "
              "is held off until it recovers. `swarm pause` if you change your mind.")
    if q:
        print(f"queued messages for: {q}")
    if pulse_running():
        print("the pulse wakes peers with work or messages on its next tick (within ~45s).")
    else:
        print("the pulse isn't running, so nobody will be woken. Run `swarm up` to start it again.")


# ---------------------------------------------------------------- up / down / status

def cmd_up(a):
    ws = os.environ.get("HERDR_WORKSPACE_ID")
    if not ws:
        sys.exit("run `swarm up` from inside herdr")
    tab, _ = swarm_tab()
    if not tab or not herdr("tab", "get", tab):
        j = herdr("tab", "create", "--workspace", ws, "--cwd", str(main_checkout()), "--label", "swarm", "--no-focus", check=True)
        tab = j["result"]["tab"]["tab_id"]; root = j["result"]["root_pane"]["pane_id"]
        with state() as s:
            s["swarm"].update(tab_id=tab, workspace_id=ws, pulse_pane=root)
        herdr("pane", "rename", root, "pulse")
        time.sleep(1)
        self_path = Path(__file__).resolve()
        herdr("pane", "run", root, f"{self_path} pulse")
        v = herdr("pane", "split", root, "--direction", "down", "--ratio", "0.5", "--cwd", str(main_checkout()), "--no-focus")
        if v:
            vp = v["result"]["pane"]["pane_id"]
            herdr("pane", "rename", vp, "viz")
            time.sleep(1)
            herdr("pane", "run", vp, f"{self_path} viz")
            with state() as s:
                s["swarm"]["viz_pane"] = vp
    for name in [x for x in (a.peers or "").split(",") if x]:
        ns = argparse.Namespace(name=name, model=a.model, thinking=None, knows=None, why="initial peer", brief=None, resume=False)
        cmd_spawn(ns)
    print(f"swarm tab {tab}")


def cmd_down(a):
    with state() as s:
        names = [n for n, p in s["peers"].items() if p.get("status") != "gone"]
        pulse = s["swarm"].get("pulse_pane")
    for n in names:
        herdr("agent", "send-keys", n, "esc")
    if pulse:
        herdr("pane", "send-keys", pulse, "ctrl+c")
    channel("system", "swarm down (agents interrupted, pulse stopped; state and worktrees kept)", by="human")
    print("down. `swarm up` restarts the pulse; `swarm spawn <name> --resume` revives a peer with its session.")


def cmd_status(a):
    with state(write=False) as s:
        paused, names, by = s["paused"], live_peers(s), s["swarm"].get("paused_by")
        summ, cfg = quota_summary(s), quota_cfg(s)
        eta = recovery_eta(s["quota"]["accounts"], cfg["windows"], cfg["resume_at"]) if summ and by == "quota" else None
    if paused:
        working = still_working(names)
        settle = f"still finishing: {', '.join(working)}" if working else "everyone has settled"
        why = ("to save Claude usage, resumes by itself" + (f" around {when(eta)}" if eta else "") + "; `swarm resume` overrides"
               if by == "quota" else "`swarm resume` to continue")
        print(f"== sliver swarm (PAUSED {why}; {settle})")
    else:
        print("== sliver swarm")
    if summ and cfg["enabled"]:
        parts = ", ".join(f"{WINDOW_NAMES[w]} {v:.0f}%" for w, v in summ[2].items())
        print(f"   Claude usage left: {parts} (auto-pause at {cfg['pause_below']}%; `swarm quota` for details)")
    print("\n== peers"); cmd_peers(argparse.Namespace(all=False))
    print("\n== needs human"); cmd_human(argparse.Namespace(sub="list", all=False, brief=True))
    print("\n== board"); cmd_task(argparse.Namespace(sub="list", all=False, mine=False))
    print("\n== channel"); cmd_log(argparse.Namespace(n=a.n))


# ---------------------------------------------------------------- sudo
# The human handed the swarm a sudo password file. `swarm sudo` is the only way peers use it:
# every command needs a reason, is logged on the channel and in sudo.log, and runs with
# `sudo -A -k` so no credential is ever cached (raw `sudo` keeps failing, so nothing bypasses
# the log). The deny list catches accidents that could brick the laptop. It is a guard rail,
# not a security boundary. Revoke by deleting the password file (it lives on tmpfs, so a
# reboot also revokes it).

SUDO_PASS_FILE = Path(os.environ.get("SWARM_SUDO_PASS", "/tmp/pass.txt"))
SUDO_DENY_CMDS = {
    "passwd", "chpasswd", "usermod", "useradd", "userdel", "visudo", "su", "sudo", "pkexec",
    "dd", "fdisk", "sfdisk", "gdisk", "sgdisk", "parted", "wipefs", "cryptsetup", "blkdiscard",
    "reboot", "poweroff", "shutdown", "halt", "kexec", "efibootmgr", "grub2-install",
    "grub2-mkconfig", "asahi-fwupdate", "update-m1n1", "mkinitrd", "dracut",
}
SUDO_DENY_RE = [
    (r"(^|[\s/=])mkfs", "formats a disk"),
    (r"(^|\s)/boot(/|\s|$)|m1n1|u-boot|/efi(/|\s|$)", "touches the boot chain (Asahi boot/firmware)"),
    (r"/etc/(sudoers|shadow|gshadow|passwd|group)\b|/etc/pam\.d", "touches users/auth"),
    (r"\brm\s+(-\S+\s+)*/(\*|\s|$)|\brm\s+(-\S+\s+)*/(usr|etc|var|boot|home|lib|lib64|bin|sbin)/?(\s|$)", "deletes a system root directory"),
    (r"\b(chmod|chown|chgrp)\s+(-\S+\s+)*-\S*R\S*\s+\S+\s+/(usr|etc|var|home|boot)?/?(\s|$)", "recursive permission change on a system root"),
    (r"systemctl\s+(\S+\s+)*(reboot|poweroff|halt|suspend|hibernate|hybrid-sleep|isolate|rescue|emergency|kexec|soft-reboot|default)\b", "changes the power/boot state"),
    (r"systemctl\s+(\S+\s+)*(stop|restart|kill|mask|disable)\s+.*\b(display-manager|sddm|gdm|greetd|lightdm|systemd-logind|dbus|dbus-broker|NetworkManager|sshd|cli-proxy\S*)\b", "would kill the human's session, network or the model proxy"),
    (r"\b(dnf|dnf5|rpm)\b.*\s(remove|erase|autoremove|distro-sync|system-upgrade|downgrade|swap|-e)\b", "removes or swaps system packages"),
    (r"\bselinux=0|setenforce\s+0|/etc/selinux/config", "disables SELinux (GOAL non-goal)"),
    (r"loginctl\s+(\S+\s+)*(terminate|kill)-?", "would end the human's session"),
]
SHELLS = {"sh", "bash", "zsh", "fish", "dash"}


def sudo_denied(argv):
    base = os.path.basename(argv[0])
    if base in SUDO_DENY_CMDS:
        return f"`{base}` is on the deny list"
    if base in SHELLS and "-c" not in argv:
        return "interactive root shells aren't allowed (use `sh -c '...'`)"
    line = " ".join(argv)
    # also check the inner command of `sh -c '...'`
    for pat, why in SUDO_DENY_RE:
        if re.search(pat, line):
            return why
    if base in SHELLS:
        inner = argv[argv.index("-c") + 1] if argv.index("-c") + 1 < len(argv) else ""
        for word in re.split(r"[;&|()\s]+", inner):
            if os.path.basename(word) in SUDO_DENY_CMDS:
                return f"`{os.path.basename(word)}` is on the deny list"
    return None


def askpass():
    """A tiny SUDO_ASKPASS helper, so the password never appears in argv, env or peers' transcripts."""
    p = home() / "askpass"
    body = f"#!/bin/sh\nexec cat {json.dumps(str(SUDO_PASS_FILE))}\n"
    if not p.exists() or p.read_text() != body:
        p.write_text(body)
    p.chmod(0o700)
    return p


def sudo_log(rec):
    append(home() / "sudo.log", rec)


def cmd_sudo(a):
    if a.log:
        for r in read_jsonl(home() / "sudo.log")[-a.n:]:
            res = "denied" if r.get("denied") else ("ok" if r.get("exit") == 0 else f"exit {r.get('exit')}")
            print(f"[{ago(r['at']):>4}] {r['by']:<7} {res:<9} {r['cmd']}")
            print(color("2", f"              why: {r.get('why') or '-'}" + (f"  ({r['denied']})" if r.get("denied") else "")))
        return
    argv = a.cmd[1:] if a.cmd and a.cmd[0] == "--" else a.cmd
    by = me(required=False) or "human"
    if a.check:
        argv = ["true"]
    if not argv:
        sys.exit("usage: swarm sudo --why \"reason\" -- COMMAND ARGS...   (or --check, --log)")
    if not SUDO_PASS_FILE.exists():
        sys.exit("swarm: no sudo access right now (the human hasn't provided it, or revoked it). "
                 "Ask: swarm human ask --kind sudo ...")
    if SUDO_PASS_FILE.stat().st_mode & 0o077:
        SUDO_PASS_FILE.chmod(0o600)
    if not a.check:
        refuse_if_paused("running sudo")
        if not a.why or len(a.why.strip()) < 8:
            sys.exit("swarm sudo needs --why \"a real reason\" (it's logged for the human)")
        bad = sudo_denied(argv)
        if bad:
            cmdline = " ".join(argv)
            sudo_log({"at": now(), "by": by, "cmd": cmdline, "why": a.why, "denied": bad})
            channel("sudo", f"DENIED: {cmdline} ({bad})", by=by)
            sys.exit(f"swarm sudo refused: {bad}. If it's truly needed, ask the human: "
                     "swarm human ask --kind sudo \"...\" --detail \"<exact command and why>\"")
    cmdline = " ".join(argv)
    env = dict(os.environ, SUDO_ASKPASS=str(askpass()))
    t0 = time.time()
    try:
        r = subprocess.run(["sudo", "-A", "-k", "--", *argv], env=env, timeout=a.timeout)
        code = r.returncode
    except subprocess.TimeoutExpired:
        code = 124
        print(f"swarm sudo: timed out after {a.timeout}s", file=sys.stderr)
    if a.check:
        print("sudo works" if code == 0 else "sudo failed: the password file is wrong or sudo is unavailable")
        sys.exit(0 if code == 0 else 1)
    sudo_log({"at": now(), "by": by, "cmd": cmdline, "why": a.why, "exit": code, "secs": round(time.time() - t0, 1)})
    channel("sudo", f"{cmdline}  ({a.why})" + ("" if code == 0 else f"  -> exit {code}"), by=by)
    sys.exit(code)


def cmd_viz(a):
    viz = Path(__file__).resolve().parent.parent / "viz" / "serve.py"
    os.execvp(sys.executable, [sys.executable, str(viz), "--port", str(a.port), "--host", a.host])


# ---------------------------------------------------------------- cli

def main():
    ap = argparse.ArgumentParser(prog="swarm", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)

    x = sp.add_parser("status", help="overview"); x.add_argument("-n", type=int, default=15); x.set_defaults(f=cmd_status)
    sp.add_parser("whoami").set_defaults(f=lambda a: print(me()))

    t = sp.add_parser("task", help="shared task board"); ts = t.add_subparsers(dest="sub", required=True)
    x = ts.add_parser("add"); x.add_argument("title"); x.add_argument("--body"); x.add_argument("--area")
    x.add_argument("--after", help="comma-separated task ids this waits on"); x.add_argument("--claim", action="store_true")
    x = ts.add_parser("list"); x.add_argument("--all", action="store_true"); x.add_argument("--mine", action="store_true")
    ts.add_parser("show").add_argument("id")
    x = ts.add_parser("claim"); x.add_argument("id"); x.add_argument("--force", action="store_true")
    x = ts.add_parser("note"); x.add_argument("id"); x.add_argument("text")
    x = ts.add_parser("done"); x.add_argument("id"); x.add_argument("text", nargs="?")
    x = ts.add_parser("release"); x.add_argument("id"); x.add_argument("text", nargs="?")
    x = ts.add_parser("drop"); x.add_argument("id"); x.add_argument("text")
    x = ts.add_parser("edit"); x.add_argument("id"); x.add_argument("--title"); x.add_argument("--body")
    x.add_argument("--area"); x.add_argument("--after")
    t.set_defaults(f=cmd_task)

    x = sp.add_parser("say", help="broadcast on the channel"); x.add_argument("text"); x.set_defaults(f=cmd_say)
    x = sp.add_parser("send", help="message one peer"); x.add_argument("peer"); x.add_argument("text")
    x.add_argument("--now", action="store_true", help="interrupt even if they are working"); x.set_defaults(f=cmd_send)
    x = sp.add_parser("inbox"); x.add_argument("--peek", action="store_true"); x.add_argument("--all", action="store_true"); x.set_defaults(f=cmd_inbox)
    x = sp.add_parser("log", help="read the channel"); x.add_argument("-n", type=int, default=30); x.set_defaults(f=cmd_log)

    h = sp.add_parser("human", help="needs-human queue (no subcommand: answer interactively)")
    hs = h.add_subparsers(dest="sub")
    x = hs.add_parser("ask"); x.add_argument("text", help="ONE short question")
    x.add_argument("--detail", help="context the human needs to answer")
    x.add_argument("--option", action="append", help="a choice (repeat for each)")
    x.add_argument("--pick", help="your recommendation: a/b/... or 1/2/...")
    x.add_argument("--kind", default="decision", choices=["sudo", "hardware", "taste", "decision", "external", "system", "secret"])
    x.add_argument("--task"); x.add_argument("--block", action="store_true", help="mark yourself waiting until answered")
    x = hs.add_parser("list"); x.add_argument("--all", action="store_true"); x.add_argument("--brief", action="store_true")
    hs.add_parser("go", help="answer open questions one by one")
    x = hs.add_parser("edit", help="change an earlier answer (asker is told)")
    x.add_argument("id", nargs="?"); x.add_argument("text", nargs="?")
    x = hs.add_parser("answer"); x.add_argument("id"); x.add_argument("text")
    h.set_defaults(f=cmd_human)

    x = sp.add_parser("peers"); x.add_argument("--all", action="store_true"); x.set_defaults(f=cmd_peers)
    x = sp.add_parser("knows", help="declare what you have context on"); x.add_argument("text"); x.set_defaults(f=cmd_knows)
    x = sp.add_parser("rest", help="nothing useful to do; sleep until new work/messages"); x.add_argument("reason", nargs="?"); x.set_defaults(f=cmd_rest)
    x = sp.add_parser("wake"); x.add_argument("reason", nargs="?"); x.set_defaults(f=cmd_wake)
    x = sp.add_parser("spawn", help="start a new peer (own worktree + pane)"); x.add_argument("name")
    x.add_argument("--model"); x.add_argument("--thinking"); x.add_argument("--knows"); x.add_argument("--why")
    x.add_argument("--brief"); x.add_argument("--resume", action="store_true"); x.set_defaults(f=cmd_spawn)
    x = sp.add_parser("retire"); x.add_argument("name", nargs="?"); x.add_argument("--reason"); x.set_defaults(f=cmd_retire)
    x = sp.add_parser("land", help="rebase on origin/main, check, push to main")
    x.add_argument("--no-check", action="store_true"); x.set_defaults(f=cmd_land)

    x = sp.add_parser("pulse", help="(infra) wake idle peers that have work"); x.add_argument("--interval", type=int, default=45); x.set_defaults(f=cmd_pulse)
    sp.add_parser("pause").set_defaults(f=cmd_pause)
    sp.add_parser("resume").set_defaults(f=cmd_resume)
    x = sp.add_parser("quota", help="Claude usage left, and the auto-pause/resume settings")
    x.add_argument("--pause-below", type=int, metavar="PCT", help="auto-pause at this %% left (default 40)")
    x.add_argument("--resume-at", type=int, metavar="PCT", help="auto-resume at this %% left (default 45)")
    x.add_argument("--windows", help="which limits to watch: five_hour,seven_day (default five_hour)")
    x.add_argument("--on", action="store_true"); x.add_argument("--off", action="store_true"); x.set_defaults(f=cmd_quota)
    x = sp.add_parser("up", help="(human) create swarm tab, start pulse, spawn peers")
    x.add_argument("--peers", default=""); x.add_argument("--model"); x.set_defaults(f=cmd_up)
    sp.add_parser("down", help="(human) interrupt peers, stop pulse").set_defaults(f=cmd_down)
    x = sp.add_parser("sudo", help="run ONE root command, logged (swarm sudo --why '..' -- cmd args)")
    x.add_argument("--why", help="reason, shown to the human"); x.add_argument("--timeout", type=int, default=600)
    x.add_argument("--check", action="store_true", help="just verify sudo access works")
    x.add_argument("--log", action="store_true", help="show the sudo audit log"); x.add_argument("-n", type=int, default=30)
    x.add_argument("cmd", nargs=argparse.REMAINDER); x.set_defaults(f=cmd_sudo)
    x = sp.add_parser("viz", help="live visualizer on http://localhost:7777")
    x.add_argument("--port", type=int, default=7777); x.add_argument("--host", default="127.0.0.1"); x.set_defaults(f=cmd_viz)

    a = ap.parse_args()
    if a.cmd not in ("pause", "resume", "pulse", "viz", "up", "down", "quota") and is_peer() and is_paused():
        print(f"\u23f8 {pause_note()}\n", file=sys.stderr)
    a.f(a)


if __name__ == "__main__":
    main()
