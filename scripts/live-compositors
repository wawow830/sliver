#!/usr/bin/env bash
# Run integration/{sway,labwc,river,niri}/test.sh against real compositors, headless,
# without root. Missing packages are fetched into $SLIVER_TEST_ROOT (default target/test-compositors)
# with `dnf download --resolve` + rpm2cpio: about 400 MB the first time. Not part of scripts/check.
#
#   scripts/live-compositors [--fetch-only] [sway|labwc|river|niri ...]
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
prefix=${SLIVER_TEST_ROOT:-$root/target/test-compositors}
fetch_only=0
want=()
for a in "$@"; do
    case $a in
        --fetch-only) fetch_only=1 ;;
        *) want+=("$a") ;;
    esac
done
[ ${#want[@]} -gt 0 ] || want=(sway labwc river niri)

fetch() { # name, packages...
    local name=$1; shift
    local dir=$prefix/$name
    [ -e "$dir/.done" ] && return 0
    command -v dnf >/dev/null && command -v rpm2cpio >/dev/null || { echo "need dnf and rpm2cpio to fetch $name"; return 1; }
    mkdir -p "$dir/rpms" "$dir/root"
    dnf download --resolve --destdir "$dir/rpms" "$@" >/dev/null 2>&1
    for f in "$dir"/rpms/*.rpm; do rpm2cpio "$f" | (cd "$dir/root" && cpio -idm --quiet 2>/dev/null); done
    touch "$dir/.done"
}

status=0
for c in "${want[@]}"; do
    case $c in
        sway)        fetch sway sway foot wlroots0.19 ;;
        labwc)       fetch labwc labwc foot wlroots0.19 ;;
        river)       fetch river river-classic foot ;;
        niri)        fetch niri niri sway foot wlroots0.19 ;;
        *) echo "unknown compositor $c"; exit 2 ;;
    esac
    [ $fetch_only = 1 ] && continue
    echo "=== $c"
    SLIVER_TEST_ROOT=$prefix/$c/root "$root/integration/$c/test.sh" || status=1
done
exit $status
