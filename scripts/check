#!/usr/bin/env bash
# The landing gate. `swarm land` runs this; keep it fast, deterministic, and hardware-free.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "== swarm tool"
python3 -m py_compile swarm/bin/swarm

echo "== safe-swap harness"
python3 -m unittest discover -s harness/safeswap -p 'test_*.py' -q

if [[ -f Cargo.toml ]]; then
  echo "== cargo fmt";   cargo fmt --all -- --check
  echo "== cargo clippy"; cargo clippy --workspace --all-targets --quiet -- -D warnings
  echo "== cargo test";  cargo test --workspace --quiet
fi

# sliverd units + udev rules (ADR-0005). Skipped where the tools are missing. Full behaviour test:
# packaging/itest-units.sh (needs a user systemd manager, ~10 s).
if command -v systemd-analyze >/dev/null && command -v udevadm >/dev/null; then
  echo "== packaging"
  d=target/check-units && rm -rf "$d" && mkdir -p "$d"
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/true|' packaging/systemd/sliverd.service > "$d/sliverd.service"
  cp packaging/systemd/sliverd.socket "$d/"
  out=$(systemd-analyze verify "$d/sliverd.socket" "$d/sliverd.service" 2>&1) || { echo "$out"; exit 1; }
  [[ -z "$out" ]] || { echo "$out"; exit 1; }
  udevadm verify --no-summary packaging/udev/*.rules
fi
if command -v rpmspec >/dev/null; then
  rpmspec -P packaging/rpm/sliver.spec >/dev/null
fi
# A bare file path in %install (a %files line put in the wrong section) runs as a command and breaks
# the build only after a 10-minute compile, so catch it here.
if awk '/^%install/{i=1;next} /^%(check|files|post|pre|changelog)/{i=0} i && /^%\{_[a-z]+\}\//{print FILENAME": "FNR": "$0; bad=1} END{exit bad}' packaging/rpm/sliver.spec; then :; else
  echo "packaging/rpm/sliver.spec: %files entries inside %install (see above)"; exit 1
fi
if command -v desktop-file-validate >/dev/null; then
  desktop-file-validate packaging/desktop/*.desktop
fi

# Tests must never start the real audio tools (they leak `pactl subscribe` orphans and touch the
# real PipeWire): use fake scripts via audio::Tools { wpctl, pactl } or SessionOptions::hermetic().
echo "== no real audio tools in tests"
if grep -rnE 'Tools::default\(\)|SessionOptions::default\(\)|Command::new\("(pactl|wpctl)"\)' crates/*/tests 2>/dev/null; then
  echo "tests must not start the real wpctl/pactl (see scripts/check)"; exit 1
fi

if command -v node >/dev/null; then
  echo "== desktop integration scripts"
  for f in integration/kwin/sliver-focus/contents/code/main.js integration/gnome-shell/*/extension.js; do
    tmp=$(mktemp --suffix=.mjs); cp "$f" "$tmp"; node --check "$tmp"; rm -f "$tmp"
  done
  for f in integration/kwin/sliver-focus/metadata.json integration/gnome-shell/*/metadata.json; do
    python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$f"
  done
fi

echo "check: ok"
