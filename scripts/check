#!/usr/bin/env bash
# The gate every change to main passes (CI runs it too). Keep it fast, deterministic and hardware-free.
# Each step runs a test suite or a file format's own validator; what a step checks lives beside the
# files it checks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Nothing the checks start may outlive them (orphaned test daemons and helpers pile up on the
# developer's machine): the gate runs under scripts/reap.py, which owns everything it starts and
# stops, lists and fails on whatever is left, however the gate ends.
[[ -n ${SLIVER_REAPED:-} ]] || exec env SLIVER_REAPED=1 python3 scripts/reap.py "$0" "$@"

echo "== harness and packaging"
python3 -m unittest discover -s harness/safeswap -p 'test_*.py' -q
python3 -m unittest discover -s harness/checks -p 'test_*.py' -q
python3 -m unittest discover -s packaging -p 'test_*.py' -q

echo "== docs"
# Every docs/ path named in the tree exists: references are kept pointing at what exists.
missing=$( (git grep -ohE 'docs/[A-Za-z0-9_./-]+\.(md|xml)' || true) | sort -u \
  | while read -r p; do [[ -e $p ]] || echo "$p"; done)
[[ -z $missing ]] || { echo "named but missing: $missing"; exit 1; }

echo "== cargo fmt";   cargo fmt --all -- --check
echo "== cargo clippy"; cargo clippy --workspace --all-targets --quiet -- -D warnings
# The `//!` comments are the docs: their links must resolve.
echo "== cargo doc";   RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --quiet
# Tests must never start the real audio tools (they leak `pactl subscribe` orphans and touch the
# real PipeWire): fakes go through audio::Tools { wpctl, pactl } or SessionOptions::hermetic().
# While they run, `pactl` and `wpctl` are tripwires that note who reached them and fail.
trip="$PWD/target/check-tripwire" && rm -rf "$trip" && mkdir -p "$trip/bin"
for t in pactl wpctl; do
  printf '#!/bin/sh\necho "%s $*" >> "%s/reached"\nexit 1\n' "$t" "$trip" > "$trip/bin/$t"
  chmod +x "$trip/bin/$t"
done
echo "== cargo test";  PATH="$trip/bin:$PATH" cargo test --workspace --quiet
[[ ! -s $trip/reached ]] || { echo "tests started the real audio tools:"; cat "$trip/reached"; exit 1; }

# The files' own validators, where installed. The units' behaviour in a real user manager:
# packaging/itest-units.sh (~10 s).
echo "== validators"
# has TOOL...: all installed. If not, that validator is skipped and the last line says so.
skipped=()
has() { local t; for t in "$@"; do command -v "$t" >/dev/null || { skipped+=("$t"); return 1; }; done; }
if has systemd-analyze udevadm; then
  d=target/check-units && rm -rf "$d" && mkdir -p "$d"
  # Documentation= names man pages that are only on the system once the RPM is installed.
  sed -e 's|^ExecStart=.*|ExecStart=/usr/bin/true|' -e '/^Documentation=/d' \
    packaging/systemd/sliverd.service > "$d/sliverd.service"
  cp packaging/systemd/sliverd.socket "$d/"
  out=$(systemd-analyze verify "$d/sliverd.socket" "$d/sliverd.service" 2>&1) || { echo "$out"; exit 1; }
  [[ -z "$out" ]] || { echo "$out"; exit 1; }
  udevadm verify --no-summary packaging/udev/*.rules
fi
if has rpmspec; then
  packaging/rpm/spec.py > target/check-sliver.spec && rpmspec -P target/check-sliver.spec >/dev/null
fi
if has desktop-file-validate; then desktop-file-validate packaging/desktop/*.desktop; fi
if has xmllint; then xmllint --noout packaging/mime/*.xml; fi
if has node; then
  for f in integration/kwin/sliver-focus/contents/code/main.js integration/gnome-shell/*/extension.js integration/browser/extension/background.js; do
    tmp=$(mktemp --suffix=.mjs); cp "$f" "$tmp"; node --check "$tmp"; rm -f "$tmp"
  done
fi
for f in integration/kwin/sliver-focus/metadata.json integration/gnome-shell/*/metadata.json integration/browser/extension/*.json integration/browser/native/*.json; do
  python3 -m json.tool "$f" >/dev/null
done

echo "check: ok${skipped[0]:+ (not installed, so skipped: ${skipped[*]})}"
