#!/usr/bin/env bash
# Drive sliver-settings headlessly and screenshot it: the integration/lib.sh sandbox (a private
# D-Bus, so Mirror, live status and profiles can't reach an installed agent), a sandboxed
# XDG_CONFIG_HOME, and GTK's Broadway backend in a browser via agent-browser.
#
#   scripts/settings-headless OUT.png [STEP...]
#
# STEP is one of
#   X,Y            click at X,Y (viewport 1280x820; the sidebar is at x≈100)
#   drag=X1,Y1,X2,Y2      press, move in 8 steps, release
#   key=NAME       press a key (agent-browser key names: Delete, Control+z, ...)
#   shot=FILE      screenshot now
#   shiftclick=X,Y a click with Shift held (multi-select)
#   touch=LINE     with WITH_AGENT: inject a touch on the fake bar ("tap X", "down X", "up"…)
#   wheel=X,Y,DY   scroll what's under X,Y by DY pixels (positive = down)
#   sleep=SECS
#
# Environment:
#   SANDBOX   config sandbox (default target/test-tmp/xdg-ui); put sliver/config.toml there first
#   OPEN      a file to open (e.g. a .sliver preset)
#   SESSION   agent-browser session name (default: unique per run, so peers never share one)
#   WITH_AGENT=1  also run sliverd --fake-hardware and sliver-agent on the private bus
#   PUBLISH   with WITH_AGENT: arguments for `sliverctl publish` (an app publishing items)
#   BUS_HELPER  a shell command run in the background on the private bus (e.g. a fake agent)
#
# Broadway has no implicit pointer grab: a drag that leaves the widget it started on is lost unless
# a common ancestor handles it (see crates/sliver-settings/src/bar.rs, the page-level drag).
out=${1:?usage: scripts/settings-headless OUT.png [STEP...]}
shift
. "$(dirname "$0")/../integration/lib.sh"
need agent-browser gtk4-broadwayd dbus-daemon
setup settings
sandbox=${SANDBOX:-$root/target/test-tmp/xdg-ui}
session=${SESSION:-${USER:-me}-settings-$$}
mkdir -p "$sandbox"
on_exit() { agent-browser --session "$session" close >/dev/null 2>&1; }
bin=$root/target/debug

bus
if [ -n "${WITH_AGENT:-}" ]; then
    spawn "$bin/sliverd" --fake-hardware --socket "$work/sliverd.sock" --touch-socket "$work/touch.sock" \
        --exit-after 600
    wait_until "sliverd is up" test -S "$work/sliverd.sock"
    spawn env XDG_CONFIG_HOME="$sandbox" "$bin/sliver-agent" --socket "$work/sliverd.sock"
    sleep 2
    if [ -n "${PUBLISH:-}" ]; then
        # shellcheck disable=SC2086 # PUBLISH is a word list on purpose
        spawn "$bin/sliverctl" publish $PUBLISH
        sleep 1
    fi
fi
if [ -n "${BUS_HELPER:-}" ]; then
    spawn sh -c "$BUS_HELPER"
    sleep 1
fi
display=$((20 + $$ % 50))
spawn gtk4-broadwayd ":$display"
sleep 1
spawn env XDG_CONFIG_HOME="$sandbox" GDK_DEBUG=no-portals GDK_BACKEND=broadway BROADWAY_DISPLAY=":$display" \
    "$bin/sliver-settings" ${OPEN:+"$OPEN"}
app=$last_pid
sleep 3

a() { agent-browser --session "$session" "$@" >/dev/null; }
a set viewport 1280 820
a open "http://127.0.0.1:$((8080 + display))/"
sleep 3
for step in "$@"; do
    case $step in
        shot=*) sleep 1; a screenshot "${step#shot=}"
                [ -s "${step#shot=}" ] || echo "settings-headless: no screenshot at ${step#shot=}" >&2 ;;
        key=*) a press "${step#key=}"; sleep 1.5 ;;
        sleep=*) sleep "${step#sleep=}" ;;
        touch=*) # line format: sliverd inject.rs
            printf '%s\n' "${step#touch=}" | socat - "UNIX-SENDTO:$work/touch.sock"; sleep 1.5 ;;
        wheel=*)
            IFS=, read -r x y dy <<<"${step#wheel=}"
            a mouse move "$x" "$y"; a mouse wheel "$dy"; sleep 1 ;;
        drag=*)
            IFS=, read -r x1 y1 x2 y2 <<<"${step#drag=}"
            a mouse move "$x1" "$y1"; a mouse down
            for i in 1 2 3 4 5 6 7 8; do
                a mouse move $((x1 + (x2 - x1) * i / 8)) $((y1 + (y2 - y1) * i / 8))
            done
            sleep 0.4; a mouse up; sleep 2 ;;
        shiftclick=*) # Broadway reads modifiers from the DOM event
            IFS=, read -r x y <<<"${step#shiftclick=}"
            a mouse move "$x" "$y"
            a eval "(() => { const el = document.elementFromPoint($x, $y);
                for (const t of ['mousedown', 'mouseup']) el.dispatchEvent(new MouseEvent(t, {
                    bubbles: true, clientX: $x, clientY: $y, screenX: $x, screenY: $y, button: 0,
                    buttons: t === 'mousedown' ? 1 : 0, shiftKey: true })); })()"
            sleep 1.5 ;;
        *,*) a mouse move "${step%,*}" "${step#*,}"; a mouse down; a mouse up; sleep 1.5 ;;
        *) echo "unknown step: $step" >&2; exit 2 ;;
    esac
done
sleep 1
if ! kill -0 "$app" 2>/dev/null; then
    wait "$app"; status=$?
    echo "settings-headless: sliver-settings exited (status $status); its log:" >&2
    cat "$work/sliver-settings.log" >&2
fi
a screenshot "$out"
[ -s "$out" ] || { echo "settings-headless: no screenshot at $out" >&2; exit 1; }
grep -v -e '^$' -e 'Theme parser' "$work/sliver-settings.log" >&2 || true
echo "$out"
