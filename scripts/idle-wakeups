#!/usr/bin/env python3
"""Invariant 3 end to end: how often sliverd + sliver-agent wake up when nothing happens.

Runs `sliverd --fake-hardware` and `sliver-agent` (shortened display timeouts) in a sandbox
(scripts/sandbox.py), so nothing on the machine can wake them.
It then counts voluntary context switches, i.e. sleeps after a wakeup, of every thread of both
processes and every helper process the agent starts:

  phase "on":  30 s idle with the bar on (the clock module may tick, nothing else should)
  phase "off": 30 s with the bar off (sliverd must sleep; the agent only for its own feeds)

in two scenarios:

  default: the default config, with no services at all
  full:    every event-driven module placed (privacy, language, systemd-failed-units,
           notifications, tray, network, bluetooth, graph) with quiet stand-ins for their
           services (scripts/idle-mocks: systemd, NetworkManager, BlueZ, fcitx5, a tray watcher,
           a notification server, a PipeWire socket), so a source that's connected but idle is
           measured. It fails if a source never called its service.

It fails if any phase is over budget. ~80 s per scenario; not part of scripts/check (too slow).

  scripts/idle-wakeups [--release] [--seconds N] [--scenario default|full|all]

Budgets (wakeups per second, for all the processes together) can be overridden with
IDLE_WAKEUPS_ON / IDLE_WAKEUPS_OFF (default) and IDLE_WAKEUPS_FULL_ON / IDLE_WAKEUPS_FULL_OFF.
"""

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

from sandbox import Sandbox

ROOT = Path(__file__).resolve().parent.parent
# Per second, everything together, with headroom. Measured on the Mac14,7: bar on 3.9-4.8, off
# 1.3-1.4. Most of that is the audio feed retrying without a PulseAudio server (every 30 s) and
# the D-Bus reactor. `--threads` breaks it down.
BUDGET_ON = float(os.environ.get("IDLE_WAKEUPS_ON", "8"))
BUDGET_OFF = float(os.environ.get("IDLE_WAKEUPS_OFF", "3"))
# "full", measured on the Mac14,7 with an idle audio server (stand-in pactl/wpctl): every module
# but `language` placed: on 1.5, off 0.00. With `language` and fcitx5 running: on 6.1, off 0.00
# (fcitx5 is polled with one CurrentInputMethod call every 2 s).
BUDGET_FULL_ON = float(os.environ.get("IDLE_WAKEUPS_FULL_ON", "8"))
BUDGET_FULL_OFF = float(os.environ.get("IDLE_WAKEUPS_FULL_OFF", "1.5"))
# Every event-driven module, in the main zone.
FULL_LAYOUT = """
[[layouts.default.zones]]
name = "main"
width = "fill"
modules = ["privacy", "language", "systemd-failed-units", "notifications", "status-items",
           "network", "bluetooth", "graph#cpu"]

[modules.systemd-failed-units]
hide-on-ok = false
"""
# Services that must have been called in "full", by scripts/idle-mocks' names.
FULL_SOURCES = {"systemd-system", "systemd-user", "network", "bluetooth", "fcitx", "tray",
                "notifications", "pipewire"}
SETTLE_S = 5
# Display timeouts in the sandbox config: "on" is measured before dim, "off" after off.
DIM_AFTER_S = 40
OFF_AFTER_S = 45


def children_map() -> dict[int, list[int]]:
    kids: dict[int, list[int]] = {}
    for p in Path("/proc").iterdir():
        if not p.name.isdigit():
            continue
        try:
            stat = (p / "stat").read_text()
        except OSError:
            continue
        # pid (comm) state ppid ...: comm may contain spaces, so split after the last ')'.
        ppid = int(stat.rsplit(")", 1)[1].split()[1])
        kids.setdefault(ppid, []).append(int(p.name))
    return kids


def tree(roots: list[int]) -> list[int]:
    kids = children_map()
    out, todo = [], list(roots)
    while todo:
        pid = todo.pop()
        out.append(pid)
        todo.extend(kids.get(pid, []))
    return out


def switches(pid: int) -> int:
    """Voluntary context switches of all threads of `pid` (0 if it's gone)."""
    total = 0
    try:
        tasks = list((Path("/proc") / str(pid) / "task").iterdir())
    except OSError:
        return 0
    for t in tasks:
        try:
            for line in (t / "status").read_text().splitlines():
                if line.startswith("voluntary_ctxt_switches:"):
                    total += int(line.split()[1])
        except OSError:
            pass
    return total


def comm(pid: int) -> str:
    try:
        return (Path("/proc") / str(pid) / "comm").read_text().strip()
    except OSError:
        return "?"


def thread_switches(pid: int) -> dict[str, int]:
    """Voluntary context switches per thread of `pid`, keyed `process/thread` by name."""
    out: dict[str, int] = {}
    try:
        tasks = list((Path("/proc") / str(pid) / "task").iterdir())
    except OSError:
        return out
    for t in tasks:
        try:
            name = (t / "comm").read_text().strip()
            for line in (t / "status").read_text().splitlines():
                if line.startswith("voluntary_ctxt_switches:"):
                    key = f"{comm(pid)}/{name}:{t.name}"  # tid: names are cut at 15 chars
                    out[key] = out.get(key, 0) + int(line.split()[1])
        except OSError:
            pass
    return out


def snapshot(roots: list[int], threads: bool = False) -> dict:
    if threads:
        snap: dict = {}
        for p in tree(roots):
            for k, n in thread_switches(p).items():
                snap[(p, k)] = (k, n)
        return snap
    return {p: (comm(p), switches(p)) for p in tree(roots)}


def measure(roots: list[int], seconds: float, threads: bool = False) -> tuple[float, dict[str, int]]:
    before = snapshot(roots, threads)
    time.sleep(seconds)
    after = snapshot(roots, threads)
    per: dict[str, int] = {}
    for pid, (name, n) in after.items():
        # A helper started during the window counts from zero.
        per[name] = per.get(name, 0) + n - before.get(pid, (name, 0))[1]
    return sum(per.values()) / seconds, per


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--release", action="store_true", help="use target/release (default: debug)")
    ap.add_argument("--seconds", type=float, default=30, help="length of each phase (default 30)")
    ap.add_argument("--threads", action="store_true", help="break the counts down per thread")
    ap.add_argument("--scenario", choices=["default", "full", "all"], default="all")
    a = ap.parse_args()
    if a.seconds + SETTLE_S > DIM_AFTER_S:
        ap.error(f"--seconds must be at most {DIM_AFTER_S - SETTLE_S}")

    profile = "release" if a.release else "debug"
    build = ["cargo", "build", "-q", "-p", "sliverd", "-p", "sliver-agent"]
    subprocess.run(build + (["--release"] if a.release else []), cwd=ROOT, check=True)
    bins = ROOT / "target" / profile
    ok = True
    for name in (["default", "full"] if a.scenario == "all" else [a.scenario]):
        ok &= scenario(name, bins, a)
    return 0 if ok else 1


def scenario(name: str, bins: Path, a: argparse.Namespace) -> bool:
    full = name == "full"
    config = (f'[display]\ndim-after = "{DIM_AFTER_S}s"\noff-after = "{OFF_AFTER_S}s"\n'
              + (FULL_LAYOUT if full else ""))
    with Sandbox(f"idle-wakeups.{name}", config, bins) as sb:
        sb.ok = measured(name, full, sb, a)
        if not sb.ok:
            print(f"idle-wakeups: logs kept in {sb.dir}", file=sys.stderr)
        return sb.ok


def measured(name: str, full: bool, sb: Sandbox, a: argparse.Namespace) -> bool:
    sliverd = sb.sliverd()
    seen = sb.dir / "seen"
    if full:
        # An idle audio server: `pactl subscribe` stays up and says nothing, `wpctl get-volume`
        # answers at once. (The real tools against the silent PipeWire stand-in would hang
        # until their timeout and be retried, which is the stand-in's doing, not the agent's.)
        fake_bin = sb.dir / "bin"
        fake_bin.mkdir()
        (fake_bin / "pactl").write_text('#!/bin/sh\n[ "$1" = subscribe ] && exec sleep infinity\nexit 0\n')
        (fake_bin / "wpctl").write_text('#!/bin/sh\n[ "$1" = get-volume ] && echo "Volume: 0.50"\nexit 0\n')
        for f in ("pactl", "wpctl"):
            (fake_bin / f).chmod(0o755)
        sb.base["PATH"] = f"{fake_bin}:{sb.base['PATH']}"
        # Not under the agent: the stand-ins' own wakeups aren't counted.
        log = sb.dir / "mocks.log"
        mocks = sb.start([sys.executable, str(ROOT / "scripts" / "idle-mocks"),
                          "--session", sb.bus["session"], "--system", sb.bus["system"],
                          "--pipewire", str(sb.dir / "run" / "pipewire-0"), "--seen", str(seen)],
                         "mocks.log")
        if not sb.wait(lambda: "ready" in log.read_text() or mocks.poll() is not None) \
                or "ready" not in log.read_text():
            print(f"idle-wakeups: scripts/idle-mocks didn't start; see {log}", file=sys.stderr)
            return False
    agent = sb.agent()
    roots = [sliverd.pid, agent.pid]

    time.sleep(SETTLE_S)
    for p in (sliverd, agent):
        if p.poll() is not None:
            print(f"idle-wakeups: {p.args[0]} exited early", file=sys.stderr)
            return False
    if full:
        missing = FULL_SOURCES - set(seen.read_text().split())
        if missing:
            print(f"idle-wakeups: full: never called: {', '.join(sorted(missing))} "
                  f"(the phase would prove nothing)", file=sys.stderr)
            return False
    on, on_per = measure(roots, a.seconds, a.threads)
    time.sleep(max(0.0, OFF_AFTER_S + 2 - SETTLE_S - a.seconds))
    off, off_per = measure(roots, a.seconds, a.threads)

    ok = True
    budgets = (BUDGET_FULL_ON, BUDGET_FULL_OFF) if full else (BUDGET_ON, BUDGET_OFF)
    for phase, rate, per, budget in (("on", on, on_per, budgets[0]),
                                     ("off", off, off_per, budgets[1])):
        detail = ", ".join(f"{k} {v}" for k, v in sorted(per.items(), key=lambda kv: -kv[1]))
        verdict = "ok" if rate <= budget else "OVER BUDGET"
        print(f"{name:>7} {phase:>3}: {rate:5.2f} wakeups/s (budget {budget}) {verdict}   [{detail}]")
        ok &= rate <= budget
    return ok


if __name__ == "__main__":
    sys.exit(main())
