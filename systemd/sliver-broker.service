[Unit]
Description=Sliver Touch Bar hardware broker
After=systemd-logind.service
Conflicts=tiny-dfr.service
Before=tiny-dfr.service

[Service]
Type=simple
User=sliver
Group=sliver
RuntimeDirectory=sliver
StateDirectory=sliver
Environment=SLIVER_BROKER_SOCKET=/run/sliver/broker.sock
ExecStart=/usr/bin/sliver-broker
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
