[Unit]
Description=Sliver Touch Bar hardware broker
After=systemd-logind.service
Conflicts=tiny-dfr.service
Before=tiny-dfr.service
[Service]
Type=notify
NotifyAccess=main
KillSignal=SIGINT
FinalKillSignal=SIGKILL
User=sliver
Group=sliver-supervisors
SupplementaryGroups=sliver-drm sliver-input sliver-backlight
RuntimeDirectory=sliver
RuntimeDirectoryMode=0750
StateDirectory=sliver
Environment=SLIVER_BROKER_SOCKET=/run/sliver/broker.sock
ExecStart=/usr/libexec/sliver/sliver-broker
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
