[Unit]
Description=Sliver per-user Lua supervisor
After=graphical-session.target
PartOf=graphical-session.target
ConditionGroup=sliver-supervisors

[Service]
Type=simple
KillSignal=SIGINT
ExecStart=/usr/libexec/sliver/sliver-supervisor
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=graphical-session.target
