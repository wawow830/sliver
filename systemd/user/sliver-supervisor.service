[Unit]
Description=Sliver per-user Lua supervisor
After=graphical-session.target
# Keep the supervisor alive across fast user switches. It retries the broker
# claim and reconnects when this user's seat session becomes active again.
ConditionGroup=sliver-supervisors

[Service]
Type=simple
KillSignal=SIGINT
FinalKillSignal=SIGKILL
ExecStart=/usr/libexec/sliver/sliver-supervisor
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s

[Install]
WantedBy=graphical-session.target
