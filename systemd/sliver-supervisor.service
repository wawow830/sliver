[Unit]
Description=Sliver Touch Bar hardware broker
After=systemd-logind.service
Conflicts=tiny-dfr.service
Before=tiny-dfr.service

[Service]
Type=simple
User=sliver
Group=sliver
RuntimeDirectory=sliver
StateDirectory=sliver
Environment=SLIVER_SUPERVISOR_SOCKET=/run/sliver/supervisor.sock
Environment=SLIVER_STATE_FILE=/var/lib/sliver/config-path
ExecStart=/usr/bin/sliver-supervisor
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
