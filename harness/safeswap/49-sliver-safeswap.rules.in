// Lets @USER@ run the sliver safe-swap helper without a password: scripted runs may not be in an
// "active" logind session. Remove this file to require a password again.
polkit.addRule(function (action, subject) {
    if (action.id == "org.sliver.safeswap" && subject.user == "@USER@") {
        return polkit.Result.YES;
    }
});
