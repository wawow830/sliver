{
  "manifest_version": 3,
  "name": "Sliver Touch Bar",
  "version": "0.1.0",
  "description": "Tabs, back, forward and reload on the Touch Bar of Linux Macs running Sliver.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "105",
  "key": ""
}
